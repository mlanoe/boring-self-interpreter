# == MAIN ==
#
# Accepts the same launch parameters as `boring run`, so this self-hosted
# interpreter can be swapped in for the Rust one without changing how it's
# invoked:
#     [--gpu <profile>] [file.br] [-- script-args...]
# With no file given, falls back to the `main` file declared in boring.toml
# in the current directory — mirrors `boring run` with no file argument.
#
# Uses raw_args() rather than args(): args() is meant for a script to read
# its own pass-through arguments and truncates everything before a `--`,
# which would swallow our own --gpu/file flags whenever a script also
# receives args after `--`. raw_args() returns everything, unfiltered.
#
# argv[0] convention: raw_args()[0] is this program's own name (the compiled
# binary's invoked path — see docs/book.md's "Global functions" entry), so
# our own flags/file/`--help` start at index 1, not 0.

struct RunArgs:
    string? gpu_profile
    string? file
    [string] script_args

def RunArgs parse_run_args([string] argv):
    var string? gpu_profile = nil
    var string? file = nil
    mut [string] script_args = []
    var int i = 0
    while i < argv.length:
        let a = argv[i]
        if a == "--gpu":
            i = i + 1
            if i < argv.length:
                gpu_profile = argv[i]
            else:
                error "error: --gpu requires a profile name"
                exit(1)
        elif a == "--":
            i = i + 1
            while i < argv.length:
                script_args.push(argv[i])
                i = i + 1
            return RunArgs(gpu_profile, file, script_args)
        elif a.startsWith("-"):
            error "error: unknown run flag '{a}'"
            exit(1)
        else:
            if file != nil:
                error "error: unexpected extra argument '{a}' (a file was already given)"
                exit(1)
            file = a
        i = i + 1
    RunArgs(gpu_profile, file, script_args)

def void print_help():
    print "Boring language interpreter (self-hosted)"
    print ""
    print "USAGE:"
    print "    <interpreter> [--gpu <profile>] [file.br] [-- args...]"
    print "    <interpreter>                        Run the project in the current directory"
    print "    <interpreter> --help | -h             Show this help"
    print ""
    print "Accepts the same launch parameters as `boring run`, so it can be"
    print "swapped in for the Rust interpreter without changing invocation syntax."

# Extracts the value from a `key = "value"` or `key = value` boring.toml line.
def string extract_toml_value(string line):
    let parts = line.split("=")
    if parts.length < 2:
        return ""
    var string val = parts[1].trim()
    var int i = 2
    while i < parts.length:
        val = val + "=" + parts[i].trim()
        i = i + 1
    if val.length >= 2 and val.startsWith("\"") and val.endsWith("\""):
        return val.slice(1, val.length - 1)
    val

# Reads the `main` file declared in boring.toml, mirroring the Rust
# interpreter's `run_project()`. Defaults to "main.br" if unspecified.
def string resolve_project_main() throws:
    let content = fs.read("boring.toml")
    var string main_file = "main.br"
    for line in content.split("\n"):
        let trimmed = line.trim()
        if trimmed.startsWith("main"):
            let v = extract_toml_value(trimmed)
            if v.length > 0:
                main_file = v
    main_file

# Splits BORING_PATH on `;` (Windows) or `:` (Unix, preserving `C:\...` drive colons).
def [string] split_boring_path(string raw):
    if raw.length == 0:
        return []
    if raw.contains(";"):
        return raw.split(";")
    if raw.contains(":"):
        let first_colon = raw.indexOf(":") else -1
        if first_colon != 1 or raw.slice(2, raw.length).contains(":"):
            return raw.split(":")
    [raw]

# Collapses `.` and `seg/..` segments in a slash-normalized path.
def string normalize_rel_path(string path):
    let norm = path.replace("\\", "/")
    let has_drive = norm.length >= 2 and norm.slice(1, 2) == ":"
    let is_abs = norm.startsWith("/") or has_drive
    mut [string] stack = []
    for part in norm.split("/"):
        if part.length == 0 or part == ".":
            continue
        if part == "..":
            if stack.length > 0 and stack[stack.length - 1] != "..":
                stack.remove(stack.length - 1)
            elif not is_abs:
                stack.push("..")
        else:
            stack.push(part)
    if norm.startsWith("/"):
        return "/" + stack.join("/")
    if stack.length == 0:
        return "."
    stack.join("/")

# Walks up from `source_path` (or CWD if relative/stdin) looking for `boring.toml`.
def string? find_project_root(string? source_path):
    var bool check_cwd_parents = true
    if let sp = source_path:
        let norm = sp.replace("\\", "/")
        let has_drive = norm.length >= 2 and norm.slice(1, 2) == ":"
        if norm.startsWith("/") or has_drive:
            check_cwd_parents = false
        var string dir = if fs.isDir(norm.clone()): norm else: use_dirname(norm)
        while dir.length > 0:
            if fs.isFile(use_join_path(dir.clone(), "boring.toml")):
                return dir
            let parent = use_dirname(dir.clone())
            if parent == dir:
                break
            dir = parent
        if fs.isFile("boring.toml"):
            return "."
    if check_cwd_parents:
        if fs.isFile("boring.toml"):
            return "."
        var string up = ".."
        var int depth = 0
        while depth < 16 and fs.isDir(up.clone()):
            if fs.isFile(use_join_path(up.clone(), "boring.toml")):
                return up
            up = "../" + up
            depth = depth + 1
    nil

# Extracts a local `path` from a `[deps]` value (`"../dep"` or `{ path = "../dep", ... }`).
def string? parse_dep_path_value(string raw):
    let v = raw.trim()
    if v.length >= 2 and v.startsWith("\"") and v.endsWith("\""):
        return v.slice(1, v.length - 1)
    if v.startsWith("{{") and v.endsWith("}}"):
        let inner = v.slice(1, v.length - 1)
        for entry in inner.split(","):
            let kv = entry.trim()
            if kv.startsWith("path"):
                let eq = kv.indexOf("=") else -1
                if eq >= 0:
                    let rhs = kv.slice(eq + 1, kv.length).trim()
                    if rhs.length >= 2 and rhs.startsWith("\"") and rhs.endsWith("\""):
                        return rhs.slice(1, rhs.length - 1)
    nil

# Parses `[deps]` from `<root_dir>/boring.toml` recursively into `interp.deps`.
def void resolve_toml_deps(mut Interpreter interp, string root_dir, mut [string] visited):
    let norm_root = normalize_rel_path(root_dir.clone())
    if visited.contains(norm_root):
        return
    visited.push(norm_root.clone())
    let toml_path = use_join_path(norm_root.clone(), "boring.toml")
    if not fs.isFile(toml_path):
        return
    let content = fs.read(toml_path)
    var bool in_deps = false
    for raw_line in content.split("\n"):
        let line = raw_line.trim()
        if line.length == 0 or line.startsWith("#"):
            continue
        if line.startsWith("[") and line.endsWith("]"):
            in_deps = line == "[deps]"
            continue
        if not in_deps:
            continue
        let eq = line.indexOf("=") else -1
        if eq <= 0:
            continue
        let name = line.slice(0, eq).trim()
        let raw_val = line.slice(eq + 1, line.length).trim()
        if name == "std" or name == "crate" or name == "boring":
            error "'{name}' is a reserved name and cannot be used as a [deps] dependency name"
            exit(1)
        if let dep_rel = parse_dep_path_value(raw_val):
            let dep_root = normalize_rel_path(use_join_path(norm_root.clone(), dep_rel))
            let dep_src = use_join_path(dep_root.clone(), "src")
            interp.add_dep(name, dep_src)
            resolve_toml_deps(interp, dep_root, visited)

def void main() throws:
    let raw = raw_args()
    if raw.length > 1 and (raw[1] == "--help" or raw[1] == "-h"):
        print_help()
        exit(0)
    let parsed = parse_run_args(raw.slice(1, raw.length))
    # GPU profile simulation isn't implemented in the self-hosted interpreter
    # yet; --gpu is accepted (for CLI compatibility with `boring run --gpu
    # <profile>`) but currently has no effect.
    var string source = ""
    var string? source_path = nil
    # argv[0] convention (see docs/book.md): the guest script's own args()
    # builtin (parser_core.br) forwards `interp.cli_args` verbatim, so index 0
    # must be the guest script's own name here, exactly like `main.rs::run_file`
    # does for the Rust interpreter's `args()`. Stays "" when the source came
    # from stdin (no file/project path to name it after). Kept as a separate
    # plain string (not re-derived from `source_path` below) because `if let`
    # on an Optional string moves it — it can only be destructured once.
    var string program_name = ""
    if let f = parsed.file:
        source = fs.read(f.clone())
        source_path = f.clone()
        program_name = f
    elif fs.exists("boring.toml"):
        let main_file = resolve_project_main()
        source = fs.read(main_file.clone())
        source_path = main_file.clone()
        program_name = main_file
    else:
        # No file, no project — read the script from stdin (pipe or redirect).
        while let ln = readLine():
            source = source + ln + "\n"
    let prog = parse(source)
    mut interp = new_interpreter()
    mut [string] full_args = [program_name]
    for a in parsed.script_args:
        full_args.push(a)
    interp.cli_args = full_args
    # Seed `use` resolution with the entry file's directory, the project's
    # `src/` dir + `boring.toml [deps]`, and `BORING_PATH` entries — matching
    # `src/main.rs::run_file`.
    if let sp = source_path.clone():
        let entry_dir = use_dirname(sp)
        if entry_dir.length > 0:
            interp.add_search_path(entry_dir)
    if let root = find_project_root(source_path):
        let src_dir = use_join_path(root.clone(), "src")
        if fs.isDir(src_dir):
            interp.add_search_path(src_dir)
        mut [string] visited_deps = []
        resolve_toml_deps(interp, root, visited_deps)
    if let bp = environment("BORING_PATH"):
        for p in split_boring_path(bp):
            let trimmed = p.trim()
            if trimmed.length > 0:
                interp.add_search_path(trimmed)
    run_program(interp, prog)
