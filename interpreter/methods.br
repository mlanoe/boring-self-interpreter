                    Value.Str("{fi:x}")
                _:
                    throw "unknown method {method_name} on {recv_type}"

        Value.Range(start, end, inclusive, step):
            match method_name:
                "toArray":
                    mut result = []
                    var i = start
                    let lim = if inclusive: end + 1 else: end
                    while i < lim:
                        result.push(Value.Int(i))
                        i = i + step
                    Value.Array(result)
                "contains":
                    let val = args[0] else Value.Nil
                    match val:
                        Value.Int(n):
                            let lim = if inclusive: end + 1 else: end
                            var found = false
                            var i = start
                            while i < lim and not found:
                                if i == n:
                                    found = true
                                i = i + step
                            Value.Bool(found)
                        _: Value.Bool(false)
                "length":
                    let lim = if inclusive: end + 1 else: end
                    let len = (lim - start + step - 1) / step
                    Value.Int(if len < 0: 0 else: len)
                "step":
                    let s_val = args[0] else Value.Int(1)
                    match s_val:
                        Value.Int(sv): Value.Range(start, end, inclusive, sv)
                        _: throw "step: expected int argument"
                _:
                    throw "unknown method {method_name} on {recv_type}"

        Value.Tuple(elems):
            match method_name:
                "length":
                    Value.Int(elems.length)
                "len":
                    Value.Int(elems.length)
                "isEmpty":
                    Value.Bool(elems.length == 0)
                "first":
                    elems[0] else Value.Nil
                "last":
                    elems[elems.length - 1] else Value.Nil
                "get":
                    let idx_val = args[0] else Value.Int(0)
                    match idx_val:
                        Value.Int(i): elems[i] else Value.Nil
                        _: throw "tuple.get: expected int"
                "map":
                    let fn_val = args[0] else Value.Nil
                    mut result = []
                    for elem in elems:
                        let mapped = call_value(interp, fn_val, [elem])
                        result.push(mapped)
                    Value.Tuple(result)
                _:
                    throw "unknown method {method_name} on tuple"

        Value.Object(inner):
            # Channel TX send method
            if inner.type_name == "__ChannelTx__" and method_name == "send":
                let ch_id_opt = inner.get_field("__ch_id__")
                if let ch_id_val = ch_id_opt:
                    let ch_key = match ch_id_val:
                        Value.Str(s): s
                        _: ""
                    if ch_key != "":
                        let val_to_send = args[0] else Value.Nil
                        let queue_opt = interp.channel_queues.get(ch_key)
                        if let queue = queue_opt:
                            var mut_queue = queue
                            mut_queue.push(val_to_send)
                            mut {string=[Value]} cq = interp.channel_queues
                            cq[ch_key] = mut_queue
                            interp.channel_queues = cq
                return Value.Nil
            # Struct method call
            let type_name = inner.type_name.clone()
            let method_decl_opt = interp.find_best_method(type_name, method_name, args)
            if let method_decl = method_decl_opt:
                let self_val = Value.Object(inner)
                # `view` methods take the mounted state (`__st`) and the environment (`__env`) as
                # trailing parameters. A call that omits them (`self.touch()` inside the view)
                # forwards the caller's own.
                var [Value] call_args = args
                var Value? forwarded_st = nil
                var fwd_i = args.length
                while fwd_i < method_decl.params.length:
                    let fwd_param_name = method_decl.params[fwd_i].name
                    if fwd_param_name == "__st":
                        let fwd_st = interp.current_env.get("__st")
                        if let fwd = fwd_st:
                            call_args = call_args + [fwd.clone()]
                            view_sync(interp, fwd.clone(), false, 1)
                            view_sync(interp, self_val.clone(), true, 1)
                            forwarded_st = fwd
                        else:
                            break
                    elif fwd_param_name == "__env":
                        let fwd_env = interp.current_env.get("__env")
                        if let fe = fwd_env:
                            call_args = call_args + [fe.clone()]
                        else:
                            break
                    else:
                        break
                    fwd_i = fwd_i + 1
                let child_env = push_scope(interp)
                env_define(interp, "self", self_val, false)
                for field in inner.fields:
                    env_define(interp, field.0, field.1, true)
                let bound_args = order_method_args(method_decl.params, call_args)
                var i = 0
                while i < method_decl.params.length and i < bound_args.length:
                    let param = method_decl.params[i]
                    # Same declared-type coercion `call_fn` applies (an untyped literal
                    # narrows to a `float32`/`fixedN_M` parameter).
                    var bound_arg = bound_args[i]
                    if let param_ty = param.ty:
                        bound_arg = coerce_declared_value(interp, bound_arg, param_ty)
                    env_define(interp, param.name, bound_arg, param.mutable)
                    mark_byvalue_param(interp, param, bound_arg)
                    i += 1
                let mutating = method_decl.mutating
                let method_params = method_decl.params
                # `view`: expose `bind`s and the mounted state's fields as locals, copy them back after.
                var has_st_param = false
                var has_env_param = false
                for vp in method_decl.params:
                    if vp.name == "__st":
                        has_st_param = true
                    if vp.name == "__env":
                        has_env_param = true
                var view_state_opt = interp.current_env.get("__st")
                if not has_st_param:
                    view_state_opt = nil
                view_sync(interp, self_val.clone(), true, 0)
                if let vs = view_state_opt:
                    view_sync(interp, vs, false, 0)
                # `env` values are read-only locals of the view's methods.
                if has_env_param:
                    let view_env_opt = interp.current_env.get("__env")
                    if let veo = view_env_opt:
                        match veo:
                            Value.Object(env_obj):
                                for ef in env_obj.fields:
                                    if not ef.0.starts_with("__"):
                                        env_define(interp, ef.0, ef.1, false)
                            _: nil
                let result = exec_method_body(interp, method_decl)
                let method_scope = interp.current_env
                capture_var_param_outs(interp, method_params, method_scope)
                if mutating:
                    for field in inner.fields:
                        let updated = interp.current_env.get(field.0)
                        if let v = updated:
                            inner.set_field(field.0, v)
                else:
                    # `req` method writing an `'actor`/`'guard` field (e.g. `memo[k] = w`).
                    let shared_fields = interior_mutable_fields(interp, type_name.clone())
                    for field in inner.fields:
                        if shared_fields.contains(field.0):
                            let updated = interp.current_env.get(field.0)
                            if let v = updated:
                                inner.set_field(field.0, v)
                view_sync(interp, self_val.clone(), true, 1)
                if let vs2 = view_state_opt:
                    view_sync(interp, vs2, false, 1)
                drop_scope_subscriptions(interp, interp.current_env, -1)
                pop_scope(interp)
                if let fst = forwarded_st:
                    view_sync(interp, fst, false, 2)
                    view_sync(interp, self_val.clone(), true, 2)
                result
            else:
                # `upgrade()` on weak ref — in the interpreter all refs are strong, just return self
                if method_name == "upgrade":
                    return Value.Object(inner)
                # A `view`: the runtime-facing generated methods, then method-form modifiers.
                if let view_decl = interp.get_struct_decl(type_name.clone()):
                    if decl_is_view(view_decl):
                        if let vres = view_runtime_method(interp, Value.Object(inner), inner, view_decl, method_name, args):
                            return vres
                        if inner.get_field(method_name) == nil:
                            if let modres = view_modifier_call(interp, Value.Object(inner), method_name, args):
                                return modres
                # A function-typed field called with method syntax: `obj.onTap(args)`.
                let fn_field_opt = inner.get_field(method_name)
                if let fn_field = fn_field_opt:
                    match fn_field:
                        Value.Fn(_, _): return call_value(interp, fn_field, args)
                        Value.Closure(_, _, _): return call_value(interp, fn_field, args)
                        Value.NativeFn(_, _): return call_value(interp, fn_field, args)
                        Value.OverloadedFn(_, _): return call_value(interp, fn_field, args)
                        _: nil
                throw "unknown method {method_name} on {type_name}"

        Value.StructDef(type_name):
            let method_opt = interp.find_best_method("__type__." + type_name, method_name, args)
            if let decl = method_opt:
                return call_fn(interp, decl, args, nil)
            throw "no type method '{method_name}' on struct '{type_name}'"

        Value.EnumDef(type_name):
            let method_opt = interp.find_best_method("__type__." + type_name, method_name, args)
            if let decl = method_opt:
                return call_fn(interp, decl, args, nil)
            # EnumDef.Variant(args) → construct enum variant
            Value.EnumVariant(type_name, method_name, args)

        Value.EnumVariant(type_name, variant, fields):
            # Enum variant method call — look up in interp method table
            let method_decl_opt = interp.find_best_method(type_name, method_name, args)
            if let method_decl = method_decl_opt:
                let self_val = Value.EnumVariant(type_name, variant, fields)
                let child_env = push_scope(interp)
                env_define(interp, "self", self_val, false)
                let bound_args = order_method_args(method_decl.params, args)
                var i = 0
                while i < method_decl.params.length and i < bound_args.length:
                    let param = method_decl.params[i]
                    # Same declared-type coercion `call_fn` applies (an untyped literal
                    # narrows to a `float32`/`fixedN_M` parameter).
                    var bound_arg = bound_args[i]
                    if let param_ty = param.ty:
                        bound_arg = coerce_declared_value(interp, bound_arg, param_ty)
                    env_define(interp, param.name, bound_arg, param.mutable)
                    mark_byvalue_param(interp, param, bound_arg)
                    i += 1
                let method_params = method_decl.params
                let result = exec_method_body(interp, method_decl)
                let method_scope = interp.current_env
                capture_var_param_outs(interp, method_params, method_scope)
                pop_scope(interp)
                result
            else:
                throw "no method '{method_name}' on enum '{type_name}'"

        _:
            throw "unknown method {method_name} on {recv_type}"
