use std.time.SystemTime, UNIX_EPOCH
use std.net.TcpListener, TcpStream
use std.io.Read, Write
# == BUILT-IN METHODS ==

# Generalized instead of one hand-written match arm per numeric-kind pair —
# see the NumKind model in eval.br (num_kind_of/value_as_i128/etc.).
def bool value_lt(Value a, Value b):
    # float32/float64 compare freely against each other and against any int
    # kind (widened to float64) — same permissive precedent as elsewhere
    # (docs/float-width-types.md §3).
    let a_is_float = match a:
        Value.Float64(_): true
        Value.Float32(_): true
        Value.Float16(_): true
        _: false
    let b_is_float = match b:
        Value.Float64(_): true
        Value.Float32(_): true
        Value.Float16(_): true
        _: false
    if a_is_float or b_is_float:
        guard let af = value_as_float64_widened(a) else: return false
        guard let bf = value_as_float64_widened(b) else: return false
        af < bf
    else:
        match a:
            Value.Str(x):
                match b:
                    Value.Str(y): x < y
                    _: false
            _:
                guard let av = value_as_i128(a) else: return false
                guard let bv = value_as_i128(b) else: return false
                av < bv

def string val_type_name(Value v):
    match v:
        Value.Int(_): "int"
        Value.Uint(_): "uint"
        Value.Uint8(_): "uint8"
        Value.Int8(_): "int8"
        Value.Int16(_): "int16"
        Value.Int32(_): "int32"
        Value.Int64(_): "int64"
        Value.Int128(_): "int128"
        Value.Uint16(_): "uint16"
        Value.Uint32(_): "uint32"
        Value.Uint64(_): "uint64"
        Value.Uint128(_): "uint128"
        Value.Float64(_): "float"
        Value.Float32(_): "float32"
        Value.Float16(_): "float16"
        Value.Str(_): "string"
        Value.Bool(_): "bool"
        Value.Array(_): "array"
        Value.LabeledArray(_, _): "array"
        Value.Dict(_): "dict"
        Value.Set(_): "set"
        Value.Nil: "nil"
        Value.Void: "void"
        Value.Tuple(_): "tuple"
        Value.Range(_, _, _, _): "range"
        Value.Object(inner): inner.type_name.clone()
        Value.EnumVariant(type_name, _, _): type_name
        _: "unknown"

# Simplified static type check used for method-overload resolution — mirrors
# src/interpreter/methods.rs::value_matches_type_static. Every recognized
# primitive `Type` variant compares its keyword against `val_type_name(val)`,
# which already uses the identical keyword spellings ("int", "float" for
# Float64, "float32" for Float32, etc.) — see val_type_name above. A `Named`
# type that isn't one of those keywords is a custom struct/enum name; it is
# always accepted without checking the value's actual type name, the same
# simplification the Rust reference implementation makes (find_best_method's
# job is picking *an* overload, not fully type-checking the call).
def bool value_matches_named_type_static(Value val, string name):
    let vt = val_type_name(val)
    match name:
        "int": vt == "int"
        "uint": vt == "uint"
        "uint8": vt == "uint8"
        "int8": vt == "int8"
        "int16": vt == "int16"
        "int32": vt == "int32"
        "int64": vt == "int64"
        "int128": vt == "int128"
        "uint16": vt == "uint16"
        "uint32": vt == "uint32"
        "uint64": vt == "uint64"
        "uint128": vt == "uint128"
        "float16": vt == "float16"
        "f16": vt == "float16"
        "float32": vt == "float32"
        "f32": vt == "float32"
        "float": vt == "float"
        "float64": vt == "float"
        "f64": vt == "float"
        "bool": vt == "bool"
        "string": vt == "string"
        _: true

# A user struct/enum value against a `Named` parameter type: a struct/enum name needs the same
# type, a trait name needs the value's type to list it among its protocols (`struct Sq as Shape`).
# Anything else (scalars, unknown names) is left to `value_matches_type_static`.
def bool value_conforms_named_type(Interpreter interp, Value val, Type ty):
    match ty:
        Type.Qualified(inner, _): value_conforms_named_type(interp, val, inner)
        Type.Named(name):
            var vname = ""
            var [string] vprotocols = []
            var is_user_value = false
            match val:
                Value.Object(o):
                    vname = o.type_name
                    is_user_value = true
                    if let sd = interp.get_struct_decl(o.type_name):
                        vprotocols = sd.protocols
                Value.EnumVariant(etn, _, _):
                    vname = etn
                    is_user_value = true
                    if let ed = interp.get_enum_decl(etn):
                        vprotocols = ed.protocols
                _: nil
            if not is_user_value:
                return true
            if vname == name:
                return true
            if let _ = interp.get_struct_decl(name):
                return false
            if let _ = interp.get_enum_decl(name):
                return false
            # a trait (or an unknown name): the value must declare it
            for pr in vprotocols:
                if pr == name:
                    return true
            false
        _: true

def bool value_matches_type_static(Value val, Type ty):
    let vt = val_type_name(val)
    match ty:
        Type.Int: vt == "int"
        Type.Uint: vt == "uint"
        Type.Uint8: vt == "uint8"
        Type.Int8: vt == "int8"
        Type.Int16: vt == "int16"
        Type.Int32: vt == "int32"
        Type.Int64: vt == "int64"
        Type.Int128: vt == "int128"
        Type.Uint16: vt == "uint16"
        Type.Uint32: vt == "uint32"
        Type.Uint64: vt == "uint64"
        Type.Uint128: vt == "uint128"
        Type.Float16: vt == "float16"
        Type.Float32: vt == "float32"
        Type.Float64: vt == "float"
        Type.Str: vt == "string"
        Type.Bool: vt == "bool"
        Type.Qualified(inner, _): value_matches_type_static(val, inner)
        Type.Named(name): value_matches_named_type_static(val, name)
        Type.Optional(_): true
        Type.Array(_): vt == "array"
        Type.Dict(_, _): vt == "dict"
        Type.Set(_): vt == "set"
        _: true

# Normalizes a float type-name alias down to the same keyword val_type_name
# would produce ("f32"/"float32" → "float32", "f64"/"float64"/"float" →
# "float"), otherwise returns the name unchanged. Shared by
# value_matches_named_type_static (above) and type_overload_keyword (below).
def string normalize_overload_float_alias(string name):
    match name:
        "f16": "float16"
        "float16": "float16"
        "f32": "float32"
        "float32": "float32"
        "f64": "float"
        "float64": "float"
        "float": "float"
        _: name

# The outermost "shape" of a `Type`, as a keyword string, for
# types_match_for_overload below — nil for shapes that function doesn't
# compare (matches the Rust reference's fallback `_ => false`). A `Named`
# type normalizes through normalize_overload_float_alias first so
# `Named("f64")` and the dedicated `Float64` variant produce the same
# keyword; any other `Named` name (a struct/enum) passes through unchanged,
# so two `Named` types compare equal exactly when their names are equal —
# mirrors src/interpreter/mod.rs::types_match_for_overload.
def string? type_overload_keyword(Type ty):
    match ty:
        Type.Int: "int"
        Type.Uint: "uint"
        Type.Uint8: "uint8"
        Type.Int8: "int8"
        Type.Int16: "int16"
        Type.Int32: "int32"
        Type.Int64: "int64"
        Type.Int128: "int128"
        Type.Uint16: "uint16"
        Type.Uint32: "uint32"
        Type.Uint64: "uint64"
        Type.Uint128: "uint128"
        Type.Float16: "float16"
        Type.Float32: "float32"
        Type.Float64: "float"
        Type.Str: "string"
        Type.Bool: "bool"
        Type.Named(name): normalize_overload_float_alias(name)
        Type.Array(_): "array"
        Type.Dict(_, _): "dict"
        Type.Set(_): "set"
        _: nil

# Simplified type-shape equality for overload-conflict/dedup purposes — only
# the outermost shape is compared (an `[int]` and a `[string]` param count as
# the same "shape" here), same simplification the Rust reference
# implementation makes (src/interpreter/mod.rs::types_match_for_overload).
def bool types_match_for_overload(Type a, Type b):
    let ka_opt = type_overload_keyword(a)
    let kb_opt = type_overload_keyword(b)
    if let ka = ka_opt:
        if let kb = kb_opt:
            return ka == kb
    false

# True when `a` and `b` declare the same parameter count and (shape-)matching
# param types — i.e. they are the *same* overload, not two different ones.
# Used by `ext` method merging (stdlib.br's Item.Ext handling) to distinguish
# "override this exact overload" from "add a new overload with the same
# name" — mirrors src/interpreter/mod.rs::params_same_signature.
def bool params_same_signature(FnDecl a, FnDecl b):
    if a.params.length != b.params.length:
        return false
    var i = 0
    while i < a.params.length:
        let pa_ty = a.params[i].ty
        let pb_ty = b.params[i].ty
        if let ta = pa_ty:
            if let tb = pb_ty:
                if not types_match_for_overload(ta, tb):
                    return false
            else:
                return false
        else:
            if pb_ty != nil:
                return false
        i = i + 1
    true

# Order a user method's call-site args into parameter order: a `Value.Labeled` arg is
# matched to its parameter by name (so `acc.add_to(k= 2, n= m)` binds `n` and `k` correctly
# even though the labels are out of declaration order), and the remaining unlabeled args fill
# the still-unmatched params left to right — the same rule `call_fn` applies to free
# functions. A param no arg supplies stays `Value.Nil`; trailing unsupplied params are dropped
# so the caller's `i < args.length` bind loop keeps its old behavior for short calls.
def [Value] order_method_args([Param] params, [Value] args):
    mut {string=Value} labeled = {}
    mut positional = [Value]{}
    for val in args:
        match val:
            Value.Labeled(label, v): labeled.set(label, v)
            _: positional.push(val)
    mut ordered = [Value]{}
    var pos_idx = 0
    var last_filled = 0
    var i = 0
    while i < params.length:
        let pname = params[i].name.clone()
        var v = Value.Nil
        if labeled.has(pname):
            v = labeled[pname]
            last_filled = i + 1
        elif pos_idx < positional.length:
            v = positional[pos_idx]
            pos_idx = pos_idx + 1
            last_filled = i + 1
        ordered.push(v)
        i += 1
    ordered.slice(0, last_filled)

# `.clone()` on a user struct instance is a real copy: a fresh `__ref_id` (so
# `a.clone() is a` is false) and nested struct instances copied recursively.
# Every other value kind is already value-semantic here and is returned as-is.
def Value clone_value(mut Interpreter interp, Value v):
    match v:
        Value.Object(inner):
            let ref_val = inner.get_field("__ref_id")
            if let _rid = ref_val:
                var mut [(string, Value)] copied = []
                var i = 0
                while i < inner.fields.length:
                    let name = inner.fields[i].0
                    if name == "__ref_id":
                        let new_id = interp.next_ref_id
                        interp.next_ref_id = new_id + 1
                        copied.push((name, Value.Int(new_id)))
                    else:
                        copied.push((name, clone_value(interp, inner.fields[i].1)))
                    i += 1
                return Value.Object(ObjectInner(type_name= inner.type_name, fields= copied))
            return v
        _:
            return v

# `view` state helpers. A view method holds the mounted state's fields (and its `bind`s) as locals:
# fields stored in a `Slot` (a `bind`, or a `state` handed to a child's `bind`) are read through
# `.value`. `view_sync` mode 0 defines the locals, 1 copies them back into the object/slots, and
# 2 refreshes existing locals (used around a nested `self.m()` call).
def [string] view_slotted_names(mut Interpreter interp, string type_name):
    let decl_opt = interp.get_struct_decl(type_name)
    mut [string] names = []
    if let decl = decl_opt:
        for attr in decl.attrs:
            if attr.name == "slot" or attr.name == "bind":
                for an in attr.args:
                    names.push(an)
    names

# Is this declared field type an `'actor`/`'guard` (shared, interior-mutable) one? Such a
# field may be written from a non-mutating (`req`) method, so its local copy must be
# written back even when the method is not `def`.
def bool type_is_interior_mutable(Type ty):
    match ty:
        Type.Qualified(inner, qual):
            match qual:
                OwnerQual.Actor: true
                OwnerQual.Guard: true
                _: type_is_interior_mutable(inner)
        _: false

def [string] interior_mutable_fields(mut Interpreter interp, string type_name):
    let decl_opt = interp.get_struct_decl(type_name)
    mut [string] names = []
    if let decl = decl_opt:
        for f in decl.fields:
            if type_is_interior_mutable(f.ty):
                names.push(f.name)
    names

def void view_sync(mut Interpreter interp, Value target, bool slotted_only, int mode):
    match target:
        Value.Object(obj):
            let slotted = view_slotted_names(interp, obj.type_name.clone())
            for vf in obj.fields:
                let is_slot = slotted.contains(vf.0)
                if slotted_only and not is_slot:
                    continue
                var Value? slot_obj = nil
                if is_slot:
                    match vf.1:
                        Value.Object(so):
                            slot_obj = Value.Object(so)
                        _: nil
                if mode == 1:
                    let cur = interp.current_env.get(vf.0)
                    if let cv = cur:
                        if let sv = slot_obj:
                            match sv:
                                Value.Object(so2):
                                    so2.set_field("value", cv)
                                _: nil
                        else:
                            obj.set_field(vf.0, cv)
                else:
                    var Value shown = vf.1
                    if let sv2 = slot_obj:
                        match sv2:
                            Value.Object(so3):
                                let inner_val = so3.get_field("value")
                                if let iv = inner_val:
                                    shown = iv
                            _: nil
                    if mode == 0:
                        env_define(interp, vf.0, shown, true)
                    else:
                        interp.current_env.force_set(vf.0, shown)
        _: nil

# `std.time` — `Duration` (an object with a `nanos` field) and `SystemTime`
# (`unixNanos`), same representation as the Rust tree-walk interpreter.
def Value duration_value(uint128 nanos):
    Value.Object(ObjectInner(type_name= "Duration", fields= [("nanos", Value.Uint128(nanos))]))

def uint128? duration_nanos_of(Value v):
    match v:
        Value.Object(inner):
            if inner.type_name != "Duration":
                return nil
            for f in inner.fields:
                if f.0 == "nanos":
                    match f.1:
                        Value.Uint128(n): return n
                        _: nil
            nil
        _: nil

def uint128? system_time_nanos_of(Value v):
    match v:
        Value.Object(inner):
            if inner.type_name != "SystemTime":
                return nil
            for f in inner.fields:
                if f.0 == "unixNanos":
                    match f.1:
                        Value.Uint128(n): return n
                        _: nil
            nil
        _: nil

def int128? std_time_int_arg([Value] args):
    if args.length == 0:
        return nil
    let a = args[0]
    match a:
        Value.Int(n): n as int128
        Value.Uint(n): n as int128
        Value.Int64(n): n as int128
        Value.Uint64(n): n as int128
        Value.Int32(n): n as int128
        Value.Uint32(n): n as int128
        _: nil

# `fs` module of the guest program (`use fs`): the synchronous subset of the Rust
# interpreter's `fs.*`. Errors are thrown as strings, like the Rust interpreter does.
def Value? fs_fail(mut Interpreter interp, string msg):
    interp.set_pending_throw(Value.Str(msg))
    Value.Nil

Value? fs_method(mut Interpreter interp, Value recv, string method_name, [Value] args):
    match recv:
        Value.NativeFn(nname, _):
            if nname != "fs":
                return nil
            let first = args[0] else Value.Nil
            var string path = ""
            match first:
                Value.Str(ps): path = ps
                _: return fs_fail(interp, "fs.{method_name}: expected a string path")
            if method_name == "exists":
                return Value.Bool(fs.exists(path.clone()))
            if method_name == "isFile":
                return Value.Bool(fs.isFile(path.clone()))
            if method_name == "isDir":
                return Value.Bool(fs.isDir(path.clone()))
            if method_name == "read":
                let text = try? fs.read(path.clone())
                guard let content = text else: return fs_fail(interp, "fs.read: cannot read '{path}'")
                return Value.Str(content)
            if method_name == "readLines":
                let text = try? fs.read(path.clone())
                guard let content = text else: return fs_fail(interp, "fs.readLines: cannot read '{path}'")
                mut [Value] lines = []
                for line in content.lines():
                    lines.push(Value.Str(line))
                return Value.Array(lines)
            if method_name == "readBytes":
                let data = try? fs.readBytes(path.clone())
                guard let bytes = data else: return fs_fail(interp, "fs.readBytes: cannot read '{path}'")
                mut [Value] vals = []
                for b in bytes:
                    vals.push(Value.Uint8(b))
                return Value.Array(vals)
            if method_name == "write" or method_name == "append":
                let second = args[1] else Value.Nil
                var string text = ""
                match second:
                    Value.Str(ts): text = ts
                    _: return fs_fail(interp, "fs.{method_name}: expected a string")
                if method_name == "write":
                    let ok = try? fs.write(path.clone(), text.clone())
                    guard let _ = ok else: return fs_fail(interp, "fs.write: cannot write '{path}'")
                else:
                    let ok = try? fs.append(path.clone(), text.clone())
                    guard let _ = ok else: return fs_fail(interp, "fs.append: cannot write '{path}'")
                return Value.Nil
            nil
        _: nil

Value? std_time_method(Value recv, string method_name, [Value] args):
    match recv:
        Value.NativeFn(nname, _):
            if nname == "Duration":
                var unit = 0
                if method_name == "from_secs" or method_name == "fromSecs":
                    unit = 1000000000
                elif method_name == "from_millis" or method_name == "fromMillis":
                    unit = 1000000
                elif method_name == "from_micros" or method_name == "fromMicros":
                    unit = 1000
                elif method_name == "from_nanos" or method_name == "fromNanos":
                    unit = 1
                if unit == 0:
                    return nil
                if args.length > 0:
                    match args[0]:
                        Value.Float64(f):
                            return duration_value((f * (unit as float64)) as uint128)
                        _: nil
                guard let n = std_time_int_arg(args) else: return nil
                if n < 0:
                    throw "Duration: negative amount"
                return duration_value((n * (unit as int128)) as uint128)
            if nname == "SystemTime" and method_name == "now":
                let since_opt = try? SystemTime.now().durationSince(UNIX_EPOCH)
                guard let since = since_opt else: throw "SystemTime.now: clock before the Unix epoch"
                return Value.Object(ObjectInner(type_name= "SystemTime", fields= [("unixNanos", Value.Uint128(since.asNanos() as uint128))]))
            nil
        Value.Object(inner):
            if inner.type_name == "Duration":
                guard let nanos = duration_nanos_of(recv) else: return nil
                if method_name == "asSecs" or method_name == "as_secs":
                    return Value.Uint64((nanos / 1000000000) as uint64)
                if method_name == "asMillis" or method_name == "as_millis":
                    return Value.Uint128(nanos / 1000000)
                if method_name == "asMicros" or method_name == "as_micros":
                    return Value.Uint128(nanos / 1000)
                if method_name == "asNanos" or method_name == "as_nanos":
                    return Value.Uint128(nanos)
                return nil
            if inner.type_name == "SystemTime" and method_name == "durationSince":
                guard let current = system_time_nanos_of(recv) else: return nil
                var earlier = 0
                if args.length > 0:
                    match args[0]:
                        Value.NativeFn(en, _):
                            if en != "UNIX_EPOCH":
                                throw "durationSince expects a SystemTime"
                        _:
                            guard let other = system_time_nanos_of(args[0]) else: throw "durationSince expects a SystemTime"
                            earlier = other as int
                if (current as int) < earlier:
                    throw "the second SystemTime is later than the first"
                return duration_value((current as int128 - earlier as int128) as uint128)
            nil
        _: nil

# `std.net` loopback sockets of the guest program: `TcpListener.bind` / `TcpStream.connect`,
# `local_addr`, `accept`, `write`/`write_all`/`flush`, `peer_addr`. `read`/`read_exact` fill a
# caller buffer and are handled in `eval.br` (`net_read`). Errors are thrown as strings.
def Value net_fail(mut Interpreter interp, string msg):
    interp.set_pending_throw(Value.Str(msg))
    Value.Nil

def int? net_object_id(Value v):
    match v:
        Value.Object(o):
            for f in o.fields:
                if f.0 == "id":
                    match f.1:
                        Value.Uint(i): return i as int
                        _: nil
            nil
        _: nil

def Value net_object(string type_name, int id):
    Value.Object(ObjectInner(type_name= type_name, fields= [("id", Value.Uint(id as uint))]))

def [uint8]? net_bytes_arg([Value] args):
    let first = args[0] else Value.Nil
    match first:
        Value.Array(items):
            mut [uint8] out = []
            for it in items:
                match it:
                    Value.Uint8(b): out.push(b)
                    _: return nil
            out
        _: nil

def Value? net_method(mut Interpreter interp, Value recv, string method_name, [Value] args):
    match recv:
        Value.NativeFn(nname, _):
            if (nname == "TcpListener" and method_name == "bind") or (nname == "TcpStream" and method_name == "connect"):
                let first = args[0] else Value.Nil
                match first:
                    Value.Str(addr):
                        var int? made = nil
                        if nname == "TcpListener":
                            made = try? interp.net.bind(addr)
                        else:
                            made = try? interp.net.connect(addr)
                        guard let id = made else: return net_fail(interp, "{nname}.{method_name}: failed for '{addr}'")
                        return net_object(nname, id)
                    _: return net_fail(interp, "{nname}.{method_name}: expected an address string")
            nil
        Value.Object(inner):
            guard let id = net_object_id(recv) else: return nil
            if inner.type_name == "TcpListener":
                if method_name == "local_addr" or method_name == "localAddr":
                    let a = try? interp.net.listenerAddr(id)
                    guard let addr = a else: return net_fail(interp, "local_addr failed")
                    return Value.Str(addr)
                if method_name == "accept":
                    let r = try? interp.net.accept(id)
                    guard let pair = r else: return net_fail(interp, "accept failed")
                    return Value.Tuple([net_object("TcpStream", pair.0), Value.Str(pair.1)])
                return nil
            if inner.type_name == "TcpStream":
                if method_name == "write_all" or method_name == "writeAll" or method_name == "write":
                    guard let bytes = net_bytes_arg(args) else: return net_fail(interp, "write: expected a byte buffer")
                    let n = try? interp.net.writeBytes(id, bytes, method_name != "write")
                    guard let written = n else: return net_fail(interp, "write failed")
                    if method_name == "write":
                        return Value.Uint(written as uint)
                    return Value.Void
                if method_name == "flush":
                    let ok = try? interp.net.flush(id)
                    guard let _ = ok else: return net_fail(interp, "flush failed")
                    return Value.Void
                if method_name == "peer_addr" or method_name == "peerAddr" or method_name == "local_addr" or method_name == "localAddr":
                    let a = try? interp.net.streamAddr(id, method_name.startsWith("peer"))
                    guard let addr = a else: return net_fail(interp, "{method_name} failed")
                    return Value.Str(addr)
                return nil
            nil
        _: nil

# `stream.read(buf)` / `stream.read_exact(buf)`: reads into a copy of the buffer and returns
# the refilled buffer plus the byte count (void for `read_exact`). `nil` when `sock` is not a TcpStream.
def (Value, Value)? net_read(mut Interpreter interp, Value sock, Value buf, bool exact):
    guard let id = net_object_id(sock) else: return nil
    match sock:
        Value.Object(o):
            if o.type_name != "TcpStream":
                return nil
        _: return nil
    mut [uint8] bytes = []
    match buf:
        Value.Array(items):
            for it in items:
                match it:
                    Value.Uint8(b): bytes.push(b)
                    _: nil
        _: nil
    let r = try? interp.net.readInto(id, bytes, exact)
    guard let res = r else:
        _ = net_fail(interp, "read failed")
        return (Value.Nil, Value.Nil)
    mut [Value] out = []
    for b in res.0:
        out.push(Value.Uint8(b))
    if exact:
        return (Value.Array(out), Value.Void)
    (Value.Array(out), Value.Uint(res.1 as uint))

# `Introspect` (`x.introspect()`): `info.typeName`, `info.variantName`, `info.fields`, and
# `Field.get(instance)` returning a `FieldValue`-wrapped value — what the transpiled program sees.
def Value field_value_wrapped(Value v):
    let tag = match v:
        Value.Int(_): "Int"
        Value.Float64(_): "Float"
        Value.Float32(_): "Float"
        Value.Bool(_): "Bool"
        Value.Str(_): "Str"
        _: "Other"
    Value.EnumVariant("FieldValue", tag, [v])

def Value introspect_field_full(string name, int index, bool is_pub, bool is_instance, bool is_mutable, bool is_rebindable, string owner, string kind):
    Value.Object(ObjectInner(type_name= "Field", fields= [("name", Value.Str(name)), ("index", Value.Int(index)), ("isPublic", Value.Bool(is_pub)), ("isInstance", Value.Bool(is_instance)), ("isMutable", Value.Bool(is_mutable)), ("isRebindable", Value.Bool(is_rebindable)), ("__ownerType", Value.Str(owner)), ("__kind", Value.Str(kind))]))

def Value introspect_field(string name, int index):
    introspect_field_full(name, index, true, true, false, false, "", "instance")

# "int" | "float" | "bool" | "string" for a primitive/string declared type, "" otherwise.
def string introspect_prim_kind(Type? ty):
    guard let t = ty else: return ""
    match t:
        Type.Int | Type.Uint | Type.Int8 | Type.Int16 | Type.Int32 | Type.Int64 | Type.Int128 | Type.Uint8 | Type.Uint16 | Type.Uint32 | Type.Uint64 | Type.Uint128: "int"
        Type.Float32 | Type.Float64: "float"
        Type.Bool: "bool"
        Type.Str: "string"
        Type.Named(n):
            if n == "int" or n == "uint" or n == "int8" or n == "int16" or n == "int32" or n == "int64" or n == "int128" or n == "uint8" or n == "uint16" or n == "uint32" or n == "uint64" or n == "uint128" or n == "byte":
                "int"
            elif n == "float" or n == "float32" or n == "float64":
                "float"
            elif n == "bool":
                "bool"
            elif n == "string":
                "string"
            else:
                ""
        _: ""

# Checks a `FieldValue` argument against a declared primitive type (throws like `boring build`).
def string introspect_check_kind(Type? ty, Value arg, string label):
    let kind = introspect_prim_kind(ty)
    if kind == "":
        return ""
    var ok = false
    match arg:
        Value.EnumVariant(fvn, variant, fvf):
            if fvn == "FieldValue" and fvf.length == 1:
                match fvf[0]:
                    Value.Int(_): ok = kind == "int" and variant == "Int"
                    Value.Float64(_): ok = kind == "float" and variant == "Float"
                    Value.Float32(_): ok = kind == "float" and variant == "Float"
                    Value.Bool(_): ok = kind == "bool" and variant == "Bool"
                    Value.Str(_): ok = kind == "string" and variant == "Str"
                    _: nil
        _: nil
    if not ok:
        let expected = if kind == "int": "an integer" elif kind == "float": "a float" elif kind == "bool": "a bool" else "a string"
        return "wrong argument type for '{label}': expected {expected}"
    ""

def Value introspect_method_obj(string name, bool is_pub, bool is_instance, bool is_mutable, bool is_task, bool is_stream, bool is_throwing, string owner, string kind):
    var variant = "Plain"
    if is_task:
        variant = "Task"
    elif is_stream:
        variant = "Stream"
    Value.Object(ObjectInner(type_name= "Method", fields= [("name", Value.Str(name)), ("isPublic", Value.Bool(is_pub)), ("isInstance", Value.Bool(is_instance)), ("isMutable", Value.Bool(is_mutable)), ("isCallable", Value.Bool(not is_task and not is_stream)), ("isThrowing", Value.Bool(is_throwing)), ("kind", Value.EnumVariant("MethodKind", variant, [])), ("__ownerType", Value.Str(owner)), ("__kind", Value.Str(kind))]))

# Instance methods first (declaration order), then the type-level `type def`/`type req` ones.
def [Value] introspect_methods(string owner, [FnDecl] methods, [TypeMethod] type_methods):
    mut [Value] out = []
    for m in methods:
        if not m.is_native:
            out.push(introspect_method_obj(m.name, m.is_pub, true, m.mutating, m.is_task, m.is_stream, m.can_throw, owner, "instance"))
    for tm in type_methods:
        var is_set = false
        match tm.kind:
            TypeMethodKind.Set: is_set = true
            _: nil
        if not is_set:
            var is_def = false
            match tm.kind:
                TypeMethodKind.Def: is_def = true
                _: nil
            out.push(introspect_method_obj(tm.name, tm.is_pub, false, is_def, tm.is_task, false, tm.can_throw, owner, "type"))
    out

Value? introspect_method(mut Interpreter interp, Value recv, string method_name, [Value] args):
    match recv:
        Value.Object(inner):
            if inner.type_name == "Field" and (method_name == "get" or method_name == "set"):
                var string fkind = ""
                var string fowner = ""
                var string fname2 = ""
                if let kv = inner.get_field("__kind"):
                    match kv:
                        Value.Str(k): fkind = k
                        _: nil
                if let ov = inner.get_field("__ownerType"):
                    match ov:
                        Value.Str(o): fowner = o
                        _: nil
                if let nv = inner.get_field("name"):
                    match nv:
                        Value.Str(n): fname2 = n
                        _: nil
                if fkind == "type":
                    guard let osd = interp.get_struct_decl(fowner) else: throw "unknown type '{fowner}'"
                    if method_name == "get" and args.length == 0:
                        guard let cur = interp.type_var_store.get(fowner + "::" + fname2) else: throw "no type-level field '{fname2}' on '{fowner}'"
                        return field_value_wrapped(cur)
                    if method_name == "set" and args.length == 1:
                        var Type? fty = nil
                        var frebind = false
                        for tv in osd.type_vars:
                            if tv.name == fname2:
                                fty = tv.ty
                                frebind = tv.mutable and introspect_prim_kind(tv.ty) != ""
                        if not frebind:
                            interp.set_pending_throw(Value.Str("field '{fname2}' is not rebindable"))
                            return Value.Nil
                        let kind_err = introspect_check_kind(fty, args[0], fname2)
                        if kind_err != "":
                            interp.set_pending_throw(Value.Str(kind_err))
                            return Value.Nil
                        var Value payload = args[0]
                        match args[0]:
                            Value.EnumVariant(_, _, pf):
                                if pf.length == 1:
                                    payload = pf[0]
                            _: nil
                        type_var_write(interp, fowner, fname2, payload)
                        return Value.Void
            if inner.type_name == "Field" and method_name == "get" and args.length == 1:
                guard let fname_v = inner.get_field("name") else: return nil
                let fname = match fname_v:
                    Value.Str(n): n
                    _: ""
                match args[0]:
                    Value.Object(target):
                        guard let fv = target.get_field(fname) else: throw "Field.get: no such field"
                        return field_value_wrapped(fv)
                    Value.EnumVariant(_, _, evfields):
                        guard let idx_v = inner.get_field("index") else: return nil
                        match idx_v:
                            Value.Int(i): return field_value_wrapped(evfields[i])
                            _: return nil
                    _: return nil
            if inner.type_name == "Method" and method_name == "call" and args.length == 1:
                guard let owner_v = inner.get_field("__ownerType") else: return nil
                guard let name_v = inner.get_field("name") else: return nil
                guard let kind_v = inner.get_field("__kind") else: return nil
                var string owner = ""
                var string mname = ""
                var string mkind = ""
                match owner_v:
                    Value.Str(o): owner = o
                    _: nil
                match name_v:
                    Value.Str(n): mname = n
                    _: nil
                match kind_v:
                    Value.Str(k): mkind = k
                    _: nil
                if mkind != "type":
                    return nil
                mut [Value] call_args = []
                match args[0]:
                    Value.Array(items):
                        for it in items:
                            match it:
                                Value.EnumVariant(fvn, _, fvf):
                                    if fvn == "FieldValue" and fvf.length == 1:
                                        call_args.push(fvf[0])
                                    else:
                                        call_args.push(it)
                                _: call_args.push(it)
                    _: nil
                guard let tdecl = interp.find_best_method("__type__." + owner, mname, call_args) else: throw "Method.call: no type method '{mname}'"
                let call_res = call_fn(interp, tdecl, call_args, nil)
                return field_value_wrapped(call_res)
            if method_name == "introspect" and args.length == 0:
                guard let sd = interp.get_struct_decl(inner.type_name) else: return nil
                mut flds = []
                var i = 0
                for f in sd.fields:
                    flds.push(introspect_field_full(f.name, i, f.is_pub, true, f.mutable, f.mutable, sd.name, "instance"))
                    i += 1
                for tv in sd.type_vars:
                    let rebindable = tv.mutable and introspect_prim_kind(tv.ty) != ""
                    flds.push(introspect_field_full(tv.name, i, tv.is_pub, false, false, rebindable, sd.name, "type"))
                    i += 1
                return Value.Object(ObjectInner(type_name= "IntrospectInfo", fields= [("typeName", Value.Str(sd.name)), ("fields", Value.Array(flds)), ("methods", Value.Array(introspect_methods(sd.name, sd.methods, sd.type_methods)))]))
            nil
        Value.EnumVariant(tname, vname, _):
            if method_name == "introspect" and args.length == 0:
                guard let ed = interp.get_enum_decl(tname) else: return nil
                mut flds = []
                for v in ed.variants:
                    if v.name == vname:
                        var j = 0
                        for vf in v.fields:
                            var fname = "{j}"
                            if let vfn = vf.name:
                                fname = vfn
                            flds.push(introspect_field(fname, j))
                            j += 1
                return Value.Object(ObjectInner(type_name= "IntrospectInfo", fields= [("typeName", Value.Str(ed.name)), ("variantName", Value.Str(vname)), ("fields", Value.Array(flds)), ("methods", Value.Array(introspect_methods(ed.name, ed.methods, ed.type_methods)))]))
            nil
        _: nil

# ─── `view` runtime methods ───────────────────────────────────────────────────
#
# The Rust lowering (src/lower_view.rs) generates these for every `view`; here they are answered
# natively for any object whose struct carries the `view` attribute (`[state struct, env struct]`).

def string? view_state_name(StructDecl decl):
    for a in decl.attrs:
        if a.name == "view" and a.args.length >= 1:
            if a.args[0] != "":
                return a.args[0]
    nil

def string? view_env_name(StructDecl decl):
    for a in decl.attrs:
        if a.name == "view" and a.args.length >= 2:
            if a.args[1] != "":
                return a.args[1]
    nil

def bool decl_is_view(StructDecl decl):
    attrs_have(decl.attrs, "view")

def bool view_is_composite(StructDecl decl):
    for m in decl.methods:
        if m.name == "body" and m.body.length > 0:
            return true
    false

# The mounted state a view starts from: its `V__State` seeded with the description's own
# `state` arguments (`Counter(count = 10)`), the declaration's defaults otherwise.
def Value view_make_state(mut Interpreter interp, ObjectInner'actor inner, StructDecl decl, bool seeded):
    guard let state_name = view_state_name(decl) else:
        if let nodecl = interp.get_struct_decl("NoState"):
            return instantiate_struct(interp, nodecl, [])
        return Value.Object(ObjectInner(type_name= "NoState", fields= []))
    guard let sdecl = interp.get_struct_decl(state_name) else: return Value.Nil
    mut [Value] seed_args = []
    if seeded:
        for f in inner.fields:
            if f.0.starts_with("__seed_"):
                seed_args.push(Value.Labeled(f.0.slice(7, f.0.length), f.1))
    instantiate_struct(interp, sdecl, seed_args)

def string view_lower_first(string name):
    if name.length == 0:
        return name
    let string head = name.slice(0, 1)
    let string tail = name.slice(1, name.length)
    var out = head
    if ord(head) >= 65 and ord(head) <= 90:
        out = chr(ord(head) + 32)
    "{out}{tail}"

# `Text("x").padding(10.0)` is `Padding(insets = 10.0, children = [Text("x")])`: a modifier is
# any view with a `[View] children` field, named like its lowercase-first method.
def Value? view_modifier_call(mut Interpreter interp, Value recv, string method_name, [Value] args):
    mut [string] names = []
    for k in interp.struct_decls.keys():
        names.push(k)
    for vname in names:
        if view_lower_first(vname) != method_name:
            continue
        guard let mdecl = interp.get_struct_decl(vname) else: continue
        if not decl_is_view(mdecl):
            continue
        var has_children = false
        mut [string] inputs = []
        for f in mdecl.fields:
            if f.name == "children":
                has_children = true
            else:
                inputs.push(f.name)
        if not has_children:
            continue
        mut [Value] ctor_args = []
        var positional = 0
        for a in args:
            match a:
                Value.Labeled(_, _): ctor_args.push(a)
                _:
                    if positional < inputs.length:
                        ctor_args.push(Value.Labeled(inputs[positional], a))
                    positional = positional + 1
        ctor_args.push(Value.Labeled("children", Value.Array([recv])))
        return instantiate_struct(interp, mdecl, ctor_args)
    nil

# ─── dirty reports of a view callback ────────────────────────────────────────────
# A callback a view body hands to a control reports, before it runs, what it may change to the
# owner of the state it closes over (`StateOwner` -> `DirtySink`): `touch` when it provably reaches
# nothing but that view's own `state` (and the own methods it calls), `escalate` otherwise (an
# input, an `env`, a free function), so the runtime keeps the whole-window rebuild. A write through
# a `bind` also touches the owner of the bound slot. Mirrors `report_callbacks` in
# src/lower_view.rs, done here when the callback runs instead of by rewriting the body.

struct CbScan:
    var bool bad = false
    var [string] locals
    var [string] calls
    var [string] used_binds
    [string] outside
    [string] own
    [string] binds

def void scan_args(mut CbScan'actor sc, [Arg] args):
    for a in args:
        scan_expr(sc, a.value)

def void scan_stmts(mut CbScan'actor sc, [Stmt] stmts):
    for st in stmts:
        match st:
            Stmt.Let(l):
                sc.locals.push(l.name)
                if let lv = l.value:
                    scan_expr(sc, lv)
            Stmt.Expr(e): scan_expr(sc, e)
            Stmt.For(f):
                for fv in f.vars:
                    sc.locals.push(fv)
                scan_expr(sc, f.iterable)
                scan_stmts(sc, f.body)
            Stmt.If(ifs):
                for br in ifs.branches:
                    scan_expr(sc, br.cond)
                    scan_stmts(sc, br.body)
                if let eb = ifs.else_body:
                    scan_stmts(sc, eb)
            Stmt.Return(r):
                if let rv = r.value:
                    scan_expr(sc, rv)
            _: sc.bad = true

def void scan_expr(mut CbScan'actor sc, Expr e):
    match e.kind:
        ExprKind.Int(_): nil
        ExprKind.UInt64(_): nil
        ExprKind.Float(_): nil
        ExprKind.Str(_): nil
        ExprKind.Bool(_): nil
        ExprKind.Nil: nil
        ExprKind.Void: nil
        ExprKind.DotIdent(_): nil
        ExprKind.Var(n):
            if n == "__st" or sc.locals.contains(n):
                return
            if n == "self":
                sc.bad = true
            elif sc.binds.contains(n):
                if not sc.used_binds.contains(n):
                    sc.used_binds.push(n)
            elif sc.outside.contains(n):
                sc.bad = true
        ExprKind.BinOp(_, l, r):
            scan_expr(sc, l)
            scan_expr(sc, r)
        ExprKind.UnaryOp(_, x): scan_expr(sc, x)
        ExprKind.Assign(t, v):
            scan_expr(sc, t)
            scan_expr(sc, v)
        ExprKind.Field(x, _): scan_expr(sc, x)
        ExprKind.Index(a, i):
            scan_expr(sc, a)
            scan_expr(sc, i)
        ExprKind.Cast(x, _): scan_expr(sc, x)
        ExprKind.Array(elems):
            for el in elems:
                scan_expr(sc, el)
        ExprKind.Tuple(elems):
            for el in elems:
                scan_expr(sc, el)
        ExprKind.StringInterp(segs):
            for seg in segs:
                match seg:
                    StringSegment.Expr(x): scan_expr(sc, x)
                    StringSegment.FormattedExpr(x, _): scan_expr(sc, x)
                    _: nil
        ExprKind.Call(callee, args):
            match callee.kind:
                ExprKind.Var(cn):
                    let first = cn.slice(0, 1)
                    let lowercase = ord(first) >= 97 and ord(first) <= 122
                    if cn != "print" and lowercase and not sc.locals.contains(cn):
                        sc.bad = true
                _: scan_expr(sc, callee)
            scan_args(sc, args)
        ExprKind.MethodCall(recv, m, args):
            var recv_is_self = false
            match recv.kind:
                ExprKind.Var(rn):
                    if rn == "self":
                        recv_is_self = true
                _: nil
            if recv_is_self:
                if sc.own.contains(m):
                    if not sc.calls.contains(m):
                        sc.calls.push(m)
                else:
                    sc.bad = true
            else:
                scan_expr(sc, recv)
            scan_args(sc, args)
        ExprKind.Closure(ps, _, cbody, _, _):
            for cp in ps:
                sc.locals.push(cp.name)
            match cbody:
                ClosureBody.Expr(ce): scan_expr(sc, ce)
                ClosureBody.Block(cs): scan_stmts(sc, cs)
        _: sc.bad = true

# (stays in state, own methods called, binds reached) of one body.
def (bool, [string], [string]) scan_callback_body(mut Interpreter interp, [string] params, [Stmt] stmts, [string] outside, [string] own, [string] binds):
    var sc'actor = CbScan(locals= params, calls= [], used_binds= [], outside= outside, own= own, binds= binds)
    scan_stmts(sc, stmts)
    # One field per statement: reading several fields of an actor in one expression deadlocks.
    let was_bad = sc.bad
    let called = sc.calls
    let reached = sc.used_binds
    (not was_bad, called, reached)

# Reports a view callback to the owner of its state; no owner attached means nothing to report.
def void report_view_callback(mut Interpreter interp, Value hv):
    match hv:
        Value.Closure(cparams, cbody, hcap):
            guard let hc = hcap else: return
            guard let st_v = hc.get("__st") else: return
            guard let self_v = hc.get("self") else: return
            var Value? owner_opt = nil
            match st_v:
                Value.Object(st_o): owner_opt = st_o.get_field("__owner")
                _: return
            guard let owner_v = owner_opt else: return
            var ObjectInner'actor? self_o = nil
            match self_v:
                Value.Object(so): self_o = so
                _: return
            guard let view_o = self_o else: return
            guard let decl = interp.get_struct_decl(view_o.type_name) else: return
            mut [string] binds = []
            for attr in decl.attrs:
                if attr.name == "bind":
                    for bn in attr.args:
                        binds.push(bn)
            mut [string] outside = []
            for f in decl.fields:
                if not binds.contains(f.name):
                    outside.push(f.name)
            mut [string] own = []
            for m in decl.methods:
                if m.name != "body":
                    own.push(m.name)
            # Which own methods stay in state: a fixpoint, since they call each other.
            mut [string] m_names = []
            mut [[string]] m_calls = []
            mut [[string]] m_binds = []
            mut [string] local_ok = []
            for m in decl.methods:
                if m.name == "body":
                    continue
                mut mparams = []
                for mp in m.params:
                    mparams.push(mp.name)
                let scanned = scan_callback_body(interp, mparams, m.body, outside, own, binds)
                m_names.push(m.name)
                m_calls.push(scanned.1)
                m_binds.push(scanned.2)
                if scanned.0:
                    local_ok.push(m.name)
            var changed = true
            while changed:
                changed = false
                mut [string] kept = []
                for n in local_ok:
                    var all_in = true
                    var ni = 0
                    while ni < m_names.length:
                        if m_names[ni] == n:
                            for c in m_calls[ni]:
                                if not local_ok.contains(c):
                                    all_in = false
                        ni = ni + 1
                    if all_in:
                        kept.push(n)
                    else:
                        changed = true
                local_ok = kept
            mut [string] cnames = []
            for cp in cparams:
                cnames.push(cp.name)
            var [Stmt] cstmts = []
            match cbody:
                ClosureBody.Expr(ce): cstmts = [Stmt.Expr(ce)]
                ClosureBody.Block(cs): cstmts = cs
            let result = scan_callback_body(interp, cnames, cstmts, outside, own, binds)
            var precise = result.0
            mut [string] called = []
            var ri = 0
            while ri < result.1.length:
                called.push(result.1[ri])
                ri = ri + 1
            for c in called:
                if not local_ok.contains(c):
                    precise = false
            if not precise:
                _ = call_method(interp, owner_v, "escalate", [])
                return
            # The binds reached through the own methods it calls (transitively) report too.
            mut [string] used = []
            var ui = 0
            while ui < result.2.length:
                used.push(result.2[ui])
                ui = ui + 1
            mut [string] seen = []
            mut [string] todo = []
            var ti = 0
            while ti < called.length:
                todo.push(called[ti])
                ti = ti + 1
            while todo.length > 0:
                let string c = todo[todo.length - 1]
                todo.remove(todo.length - 1)
                if seen.contains(c):
                    continue
                seen.push(c)
                var ci = 0
                while ci < m_names.length:
                    if m_names[ci] == c:
                        for b in m_binds[ci]:
                            if not used.contains(b):
                                used.push(b)
                        for c2 in m_calls[ci]:
                            todo.push(c2)
                    ci = ci + 1
            _ = call_method(interp, owner_v, "touch", [])
            for b in used.sorted():
                var slot_owner = Value.Nil
                if let slot_v = view_o.get_field(b):
                    match slot_v:
                        Value.Object(slot_o):
                            if let so_f = slot_o.get_field("owner"):
                                slot_owner = so_f
                        _: nil
                match slot_owner:
                    Value.Nil: _ = call_method(interp, owner_v, "escalate", [])
                    _: _ = call_method(interp, slot_owner, "touch", [])
        _: nil

# `newOwnedState(owner)`: the seeded state linked to its owner; a state handed to a child's `bind`
# records its owner in its `Slot`, so the child's writes report to it.
def Value link_state_owner(mut Interpreter interp, Value st, Value owner):
    match st:
        Value.Object(st_o):
            st_o.set_field("__owner", owner)
            var oid = Value.Nil
            var ogen = Value.Nil
            var osink = Value.Nil
            match owner:
                Value.Object(oo):
                    if let v1 = oo.get_field("id"):
                        oid = v1
                    if let v2 = oo.get_field("generation"):
                        ogen = v2
                    if let v3 = oo.get_field("sink"):
                        osink = v3
                _: nil
            for f in st_o.fields:
                match f.1:
                    Value.Object(slot_o):
                        if slot_o.type_name == "Slot":
                            if let owner_decl = interp.get_struct_decl("StateOwner"):
                                let copy = instantiate_struct(interp, owner_decl, [Value.Labeled("id", oid), Value.Labeled("generation", ogen), Value.Labeled("sink", osink)])
                                slot_o.set_field("owner", copy)
                    _: nil
        _: nil
    st

def Value? view_runtime_method(mut Interpreter interp, Value self_val, ObjectInner'actor inner, StructDecl decl, string method_name, [Value] args):
    if method_name == "viewKind":
        return Value.Str(decl.name)
    if method_name == "viewChildren":
        if let c = inner.get_field("children"):
            return c
        return Value.Array([])
    if method_name == "viewKey":
        if let k = inner.get_field("key"):
            return k
        return Value.Str("")
    if method_name == "viewSite":
        if let s = inner.get_field("site"):
            return s
        return Value.Int(-1)
    if method_name == "isComposite":
        return Value.Bool(view_is_composite(decl))
    if method_name == "usesEnv":
        if let _ = view_env_name(decl):
            return Value.Bool(true)
        return Value.Bool(false)
    if method_name == "viewProvides":
        if decl.name == "Provide":
            if let v = inner.get_field("value"):
                return v
        return Value.Nil
    if method_name == "viewProps":
        mut [(Value, Value)] props = []
        for f in decl.fields:
            if f.name == "children":
                continue
            if let fv = inner.get_field(f.name):
                match fv:
                    Value.Nil: nil
                    Value.Array(_): nil
                    Value.Dict(_): nil
                    Value.Object(po):
                        # A bound value shows what its `Slot` holds.
                        if po.type_name == "Slot":
                            if let slot_val = po.get_field("value"):
                                props.push((Value.Str(f.name), Value.Str(display_value(interp, slot_val))))
                    Value.Closure(_, _, _): nil
                    Value.Fn(_, _): nil
                    _: props.push((Value.Str(f.name), Value.Str(display_value(interp, fv))))
        return Value.Dict(props)
    if method_name == "newOwnedState":
        let owned_st = view_make_state(interp, inner, decl, true)
        if args.length > 0:
            return link_state_owner(interp, owned_st, args[0])
        return owned_st
    # `newState()` is `seededState()`: the parent's seed per `state` field, else the initializer.
    if method_name == "newState" or method_name == "seededState":
        return view_make_state(interp, inner, decl, true)
    if method_name == "viewHandles":
        var hact = ""
        if args.length > 0:
            match args[0]:
                Value.Str(hs): hact = hs
                _: nil
        if hact == "submit":
            if let hh = inner.get_field("onSubmit"):
                match hh:
                    Value.Nil: return Value.Bool(false)
                    _: return Value.Bool(true)
        if hact == "move":
            if let hm = inner.get_field("onMove"):
                match hm:
                    Value.Nil: return Value.Bool(false)
                    _: return Value.Bool(true)
        if hact == "delete":
            if let hd = inner.get_field("onDelete"):
                match hd:
                    Value.Nil: return Value.Bool(false)
                    _: return Value.Bool(true)
        if hact == "dismiss" or hact == "select" or hact == "setSelection":
            return Value.Bool(true)
        return Value.Bool(false)
    if method_name == "viewTask":
        if let ht = inner.get_field("onTask"):
            call_value(interp, ht, args)
        return Value.Void
    if method_name == "viewAct":
        var action = ""
        var act_arg = ""
        if args.length > 0:
            match args[0]:
                Value.Str(a0): action = a0
                _: nil
        if args.length > 1:
            match args[1]:
                Value.Str(a1): act_arg = a1
                _: nil
        # The handler fields a native control carries, by the action that runs them.
        var handler_field = ""
        if action == "activate":
            handler_field = "onActivate"
        elif action == "submit":
            handler_field = "onSubmit"
        elif action == "mount":
            handler_field = "onMount"
        elif action == "unmount":
            handler_field = "onUnmount"
        if handler_field != "":
            if let hv = inner.get_field(handler_field):
                match hv:
                    Value.Nil: nil
                    Value.Closure(_, _, hcap):
                        # A callback built by a view body reports what it may change, then writes the
                        # body's locals back into the mounted state (`__st`) once it has run.
                        report_view_callback(interp, hv)
                        _ = call_value(interp, hv, [])
                        let prev_env = interp.current_env
                        if let hc = hcap:
                            interp.current_env = hc
                            if let st_local = hc.get("__st"):
                                view_sync(interp, st_local, false, 1)
                        interp.current_env = prev_env
                    _: call_value(interp, hv, [])
            return Value.Void
        # Writes through a bound `value` slot: toggle / setBool / setText / setFloat.
        if action == "toggle" or action == "setBool" or action == "setText" or action == "setFloat":
            if let sv = inner.get_field("value"):
                match sv:
                    Value.Object(slot):
                        if action == "toggle":
                            if let cur = slot.get_field("value"):
                                match cur:
                                    Value.Bool(cb): slot.set_field("value", Value.Bool(not cb))
                                    _: nil
                        elif action == "setBool":
                            slot.set_field("value", Value.Bool(act_arg == "true"))
                        elif action == "setText":
                            slot.set_field("value", Value.Str(act_arg))
                        else:
                            let parsed = act_arg.parse_float()
                            if let pf = parsed:
                                slot.set_field("value", Value.Float64(pf))
                    _: nil
            return Value.Void
        if action == "dismiss":
            if let dv = inner.get_field("isPresented"):
                match dv:
                    Value.Object(dslot): dslot.set_field("value", Value.Bool(false))
                    _: nil
            return Value.Void
        if action == "select":
            if let sel = inner.get_field("selection"):
                match sel:
                    Value.Object(sslot): sslot.set_field("value", Value.Str(act_arg))
                    _: nil
            return Value.Void
        return Value.Void
    if method_name == "expand" or method_name == "expandIn":
        var Value st_arg = Value.Nil
        if args.length > 0:
            st_arg = args[0]
        mut [Value] body_args = []
        if let expected_state = view_state_name(decl):
            # A state of another type (the runtime's placeholder `NoState`) means "mount fresh".
            var state_ok = false
            match st_arg:
                Value.Object(sto):
                    if sto.type_name == expected_state:
                        state_ok = true
                _: nil
            if not state_ok:
                st_arg = view_make_state(interp, inner, decl, true)
            body_args.push(st_arg)
        if let env_name = view_env_name(decl):
            # Each `env` field is the first value in scope (nearest ancestor first) of its type.
            var [Value] scope = []
            if method_name == "expandIn" and args.length > 1:
                match args[1]:
                    Value.Array(sc): scope = sc
                    _: nil
            guard let edecl = interp.get_struct_decl(env_name) else: return Value.Nil
            mut [Value] env_args = []
            for ef in edecl.fields:
                let want = type_decl_name(ef.ty)
                var Value? found = nil
                for sv in scope:
                    var have = ""
                    match sv:
                        Value.Object(so): have = so.type_name
                        Value.EnumVariant(etn, _, _): have = etn
                        _: nil
                    if have == want and found == nil:
                        found = sv
                if let fv = found:
                    env_args.push(Value.Labeled(ef.name, fv))
                else:
                    if let mdecl = interp.get_struct_decl("EnvMissing"):
                        return instantiate_struct(interp, mdecl, [Value.Labeled("what", Value.Str(want))])
                    return Value.Nil
            body_args.push(instantiate_struct(interp, edecl, env_args))
        return call_method(interp, self_val, "body", body_args)
    nil

# A plain (unqualified) struct parameter that is not `mut`/`var` is passed by value: storing it
# (`field = p`, `arr.push(p)`, `d[k] = p`) stores a copy, so later writes by the caller to its own
# variable stay invisible. The parameter is tagged with a hidden `__bv_<name>` marker.
def void mark_byvalue_param(mut Interpreter interp, Param param, Value bound):
    if param.mutable:
        return
    if let pty = param.ty:
        match pty:
            Type.Named(tn):
                match bound:
                    Value.Object(_):
                        if let _ = interp.get_struct_decl(tn):
                            env_define(interp, "__bv_{param.name}", Value.Bool(true), false)
                    _: nil
            _: nil

# The value to store when `e` is such a by-value parameter: a copy; anything else unchanged.
def Value byvalue_store(mut Interpreter interp, Expr e, Value v, Type? dest_ty):
    match e.kind:
        ExprKind.Var(vname):
            match v:
                Value.Object(vo):
                    # An unqualified by-value parameter is always stored as a copy.
                    let bv_flag = interp.current_env.get("__bv_{vname}")
                    if let _ = bv_flag:
                        return clone_value(interp, v)
                    # Otherwise the destination decides: a slot typed `T'actor`/`T'shared` stores
                    # the handle itself.
                    if let dt = dest_ty:
                        if type_is_alias_handle(dt):
                            return v
                    if vo.type_name == "__Observed" or vname == "self":
                        return v
                    # A bare struct variable is stored as a copy, unless it is a `'actor`/`'shared`
                    # handle (an alias, like `Rc::clone`) or an unqualified by-value parameter
                    # marked `__bv_`; an `__alias_` marker is set by `mark_alias_binding`.
                    let alias = interp.current_env.get("__alias_{vname}")
                    if let _ = alias:
                        return v
                    return clone_value(interp, v)
                _: nil
        _: nil
    v

# The type stored into by `recv.push(..)`/`recv.set(..)`/`recv[k] = ..`: the element/value type.
def Type? store_dest_type(mut Interpreter interp, Expr recv_expr):
    guard let rty0 = static_type_of(interp, recv_expr) else: return nil
    var rty = rty0
    while true:
        match rty:
            Type.Qualified(qi, _): rty = qi
            _: break
    match rty:
        Type.Array(elem): elem
        Type.ArrayN(elem, _): elem
        Type.Set(elem): elem
        Type.Dict(_, dv): dv
        _: nil

# The declared type of the slot an assignment writes: a field of an object, a field of the
# receiver, or an element of a typed collection.
def Type? assign_dest_type(mut Interpreter interp, Expr target):
    match target.kind:
        ExprKind.Var(name): self_field_type(interp, name)
        ExprKind.Field(_, _): static_type_of(interp, target)
        ExprKind.Index(coll, _): store_dest_type(interp, coll)
        _: nil

# True for `T'actor`, `T'shared`, `T'guard` (through `?`): a handle whose copies alias.
def bool type_is_alias_handle(Type ty):
    match ty:
        Type.Qualified(inner, qual):
            match qual:
                OwnerQual.Actor: true
                OwnerQual.Shared: true
                OwnerQual.Guard: true
                _: type_is_alias_handle(inner)
        Type.Optional(inner): type_is_alias_handle(inner)
        _: false

def void mark_alias_binding(mut Interpreter interp, string name, Type? ty):
    if let t = ty:
        if type_is_alias_handle(t):
            env_define(interp, "__alias_{name}", Value.Bool(true), false)

# ─── `'observed` ──────────────────────────────────────────────────────────────
#
# A `T'...'observed` value lives in a `__Observed` wrapper (field `value`): `subscribe(cb)` registers
# a callback and returns a `__Subscription` handle, any other method is forwarded to the wrapped
# value and a mutating (`def`) one then notifies every subscriber with the wrapper. `.value.m()`
# reaches the wrapped value directly and never notifies.

def Value make_observed(mut Interpreter interp, Value inner_val):
    let ref_id = interp.next_ref_id
    interp.next_ref_id = ref_id + 1
    Value.Object(ObjectInner(type_name= "__Observed", fields= [("value", inner_val), ("__ref_id", Value.Int(ref_id))]))

# Ends the subscriptions whose handle is bound directly in `env` (their `Drop`), except `keep`.
def void drop_scope_subscriptions(mut Interpreter interp, Env'actor env, int keep):
    if interp.observed_subs.length == 0:
        return
    for v in env.local_values():
        match v:
            Value.Object(so):
                if so.type_name == "__Subscription":
                    if let idv = so.get_field("id"):
                        match idv:
                            Value.Int(sid):
                                if sid != keep:
                                    mut [(int, int, Value)] remaining = []
                                    for sub in interp.observed_subs:
                                        if sub.1 != sid:
                                            remaining.push(sub)
                                    interp.observed_subs = remaining
                            _: nil
            _: nil

def Value observed_method(mut Interpreter interp, Value wrapper, ObjectInner'actor w, string method_name, [Value] args):
    var target = -1
    if let tv = w.get_field("__ref_id"):
        match tv:
            Value.Int(tid): target = tid
            _: nil
    if method_name == "subscribe" and args.length == 1:
        let sub_id = interp.observed_next_id + 1
        interp.observed_next_id = sub_id
        mut [(int, int, Value)] subs = interp.observed_subs
        subs.push((target, sub_id, args[0]))
        interp.observed_subs = subs
        return Value.Object(ObjectInner(type_name= "__Subscription", fields= [("id", Value.Int(sub_id)), ("target", Value.Int(target))]))
    let inner_v = w.get_field("value") else Value.Nil
    var mutating = false
    match inner_v:
        Value.Object(io):
            if let sd = interp.get_struct_decl(io.type_name):
                for md in sd.methods:
                    if md.name == method_name and md.mutating and not md.is_task:
                        mutating = true
        _: nil
    let result = call_method(interp, inner_v, method_name, args)
    if mutating:
        var mut [Value] callbacks = []
        for sub in interp.observed_subs:
            if sub.0 == target:
                callbacks.push(sub.2)
        for cb in callbacks:
            _ = call_value(interp, cb, [wrapper.clone()])
    result

def Value call_method(mut Interpreter interp, Value recv, string method_name, [Value] args):
    match recv:
        Value.Object(observed_w):
            if observed_w.type_name == "__Observed":
                return observed_method(interp, recv, observed_w, method_name, args)
        _: nil
    match recv:
        Value.Fixed(fraw, fsg, fn_, fm):
            if let fres = fixed_method(fraw, FixedFmt(signed = fsg, n = fn_, m = fm), method_name, args):
                return fres
        _: nil
    if let fs_res = fs_method(interp, recv, method_name, args):
        return fs_res
    if let std_res = std_time_method(recv, method_name, args):
        return std_res
    if let net_res = net_method(interp, recv, method_name, args):
        return net_res
    if method_name == "introspect" or method_name == "get" or method_name == "call" or method_name == "set":
        if let intro = introspect_method(interp, recv, method_name, args):
            return intro
    # Optionals are transparent (`T?` is the value or nil): a Rust-style `Option::unwrap_or`
    # on a present struct/enum value yields the value itself, unless the type declares its own.
    if (method_name == "unwrap_or" or method_name == "unwrapOr") and args.length == 1:
        match recv:
            Value.Object(uo_inner):
                let own = interp.find_best_method(uo_inner.type_name, method_name, args)
                if not (own != nil):
                    return recv
            _: nil
    # Rust's `is_positive` / `is_negative` on signed integers.
    if args.length == 0 and (method_name == "isPositive" or method_name == "is_positive" or method_name == "isNegative" or method_name == "is_negative"):
        let signed = match recv:
            Value.Int(_): true
            Value.Int8(_): true
            Value.Int16(_): true
            Value.Int32(_): true
            Value.Int64(_): true
            Value.Int128(_): true
            _: false
        if signed:
            if let sv = value_as_i128(recv):
                if method_name == "isPositive" or method_name == "is_positive":
                    return Value.Bool(sv > 0)
                return Value.Bool(sv < 0)
    if method_name == "clone" and args.length == 0:
        return clone_value(interp, recv)
    let recv_type = recv.type_name()
    if method_name == "pow" and (is_fixed_width_int_name(recv_type) or recv_type == "int" or recv_type == "uint" or recv_type == "uint8"):
        if args.length != 1:
            throw "pow: expected one integer exponent"
        let exponent = match args[0]:
            Value.Int(n): n as uint32
            Value.Uint(n): n as uint32
            Value.Uint8(n): n as uint32
            Value.Int8(n): n as uint32
            Value.Int16(n): n as uint32
            Value.Int32(n): n as uint32
            Value.Int64(n): n as uint32
            Value.Int128(n): n as uint32
            Value.Uint16(n): n as uint32
            Value.Uint32(n): n as uint32
            Value.Uint64(n): n as uint32
            Value.Uint128(n): n as uint32
            _: throw "pow: expected one integer exponent"
        match recv:
            Value.Int(n):
                if let result = n.checked_pow(exponent):
                    return Value.Int(result)
                throw "pow: integer overflow"
            Value.Uint(n):
                if let result = n.checked_pow(exponent):
                    return Value.Uint(result)
                throw "pow: integer overflow"
            Value.Uint8(n):
                if let result = n.checked_pow(exponent):
                    return Value.Uint8(result)
                throw "pow: integer overflow"
            Value.Int8(n):
                if let result = n.checked_pow(exponent):
                    return Value.Int8(result)
                throw "pow: integer overflow"
            Value.Int16(n):
                if let result = n.checked_pow(exponent):
                    return Value.Int16(result)
                throw "pow: integer overflow"
            Value.Int32(n):
                if let result = n.checked_pow(exponent):
                    return Value.Int32(result)
                throw "pow: integer overflow"
            Value.Int64(n):
                if let result = n.checked_pow(exponent):
                    return Value.Int64(result)
                throw "pow: integer overflow"
            Value.Int128(n):
                if let result = n.checked_pow(exponent):
                    return Value.Int128(result)
                throw "pow: integer overflow"
            Value.Uint16(n):
                if let result = n.checked_pow(exponent):
                    return Value.Uint16(result)
                throw "pow: integer overflow"
            Value.Uint32(n):
                if let result = n.checked_pow(exponent):
                    return Value.Uint32(result)
                throw "pow: integer overflow"
            Value.Uint64(n):
                if let result = n.checked_pow(exponent):
                    return Value.Uint64(result)
                throw "pow: integer overflow"
            Value.Uint128(n):
                if let result = n.checked_pow(exponent):
                    return Value.Uint128(result)
                throw "pow: integer overflow"
            _: nil
    match recv:
        Value.Str(s):
            match method_name:
                "length":
                    Value.Int(s.length)
                "len":
                    Value.Int(s.length)
                "count":
                    Value.Int(s.length)
                "split":
                    let sep = args[0] else Value.Str("")
                    match sep:
                        Value.Str(sv):
                            Value.Array(s.split(sv).map((part): Value.Str(part)))
                        _: throw "split: expected string separator"
                "trim":
                    Value.Str(s.trim())
                "trimStart":
                    Value.Str(s.trimStart())
                "trimEnd":
                    Value.Str(s.trimEnd())
                "hasPrefix":
                    let hp = args[0] else Value.Str("")
                    match hp:
                        Value.Str(hv): Value.Bool(s.startsWith(hv))
                        _: throw "hasPrefix: expected string argument"
                "hasSuffix":
                    let hs = args[0] else Value.Str("")
                    match hs:
                        Value.Str(hv): Value.Bool(s.endsWith(hv))
                        _: throw "hasSuffix: expected string argument"
                "replaceAll":
                    let ra_from = args[0] else Value.Str("")
                    let ra_to = args[1] else Value.Str("")
                    match ra_from:
                        Value.Str(rf):
                            match ra_to:
                                Value.Str(rt): Value.Str(s.replace(rf, rt))
                                _: throw "replaceAll: expected string arguments"
                        _: throw "replaceAll: expected string arguments"
                "toString":
                    Value.Str(s)
                "startsWith":
                    let arg = args[0] else Value.Str("")
                    match arg:
                        Value.Str(sv): Value.Bool(s.startsWith(sv))
                        _: throw "startsWith: expected string argument"
                "endsWith":
                    let arg = args[0] else Value.Str("")
                    match arg:
                        Value.Str(sv): Value.Bool(s.endsWith(sv))
                        _: throw "endsWith: expected string argument"
                "contains":
                    let arg = args[0] else Value.Str("")
                    match arg:
                        Value.Str(sv): Value.Bool(s.contains(sv))
                        _: throw "contains: expected string argument"
                "replace":
                    let from_val = args[0] else Value.Str("")
                    let to_val = args[1] else Value.Str("")
                    match from_val:
                        Value.Str(from_s):
                            match to_val:
                                Value.Str(to_s): Value.Str(s.replace(from_s, to_s))
                                _: throw "replace: expected string arguments"
                        _: throw "replace: expected string arguments"
                "toUpper":
                    Value.Str(s.toUpper())
                "upper":
                    Value.Str(s.toUpper())
                "to_upper":
                    Value.Str(s.toUpper())
                "toLower":
                    Value.Str(s.toLower())
                "lower":
                    Value.Str(s.toLower())
                "to_lower":
                    Value.Str(s.toLower())
                "chars":
                    Value.Array(s.chars().map((c): Value.Str(c)))
                "as_bytes":
                    Value.Array(s.as_bytes().map((b): Value.Uint8(b)))
                "asBytes":
                    Value.Array(s.as_bytes().map((b): Value.Uint8(b)))
                "graphemes":
                    Value.Array(s.graphemes().map((g): Value.Str(g)))
                "graphemeSlice":
                    let gn = s.graphemeCount
                    let from_raw = match (args[0] else Value.Int(0)):
                        Value.Int(n): n
                        _: 0
                    let to_raw = match (args[1] else Value.Int(gn)):
                        Value.Int(n): n
                        _: gn
                    # Out-of-range bounds clamp to [0, graphemeCount]; an inverted range is "".
                    let from_i = from_raw.max(0).min(gn)
                    let to_i = to_raw.max(0).min(gn)
                    Value.Str(s.graphemeSlice(from_i, to_i))
                "lines":
                    Value.Array(s.split("\n").map((l): Value.Str(l)))
                "slice":
                    let start_val = args[0] else Value.Int(0)
                    let end_val = args[1] else Value.Int(s.length)
                    match start_val:
                        Value.Int(start):
                            match end_val:
                                Value.Int(end):
                                    # Clamp exactly like the native `a[m..<n]` slice syntax
                                    # (see ExprKind.SliceRange in eval.br) — negative indices
                                    # count from the end, out-of-bounds indices clamp to the
                                    # string's own bounds, and an empty/inverted range yields
                                    # "" instead of panicking (this used to pass start/end
                                    # straight through to `s.slice`, so e.g. `"hi".slice(-1, 3)`
                                    # would crash instead of the Python-like idiom it looks like).
                                    let len = s.length
                                    let lo = if start < 0: (len + start).max(0) else: start.min(len)
                                    let hi = if end < 0: (len + end).max(0) else: end.min(len)
                                    if lo >= len or lo >= hi:
                                        Value.Str("")
                                    else:
                                        Value.Str(s.slice(lo, hi))
                                _: throw "slice: expected int end"
                        _: throw "slice: expected int start"
                "indexOf":
                    let arg = args[0] else Value.Str("")
                    match arg:
                        Value.Str(sv):
                            let idx = s.indexOf(sv)
                            if let idx_val = idx:
                                Value.Int(idx_val)
                            else:
                                Value.Nil
                        _: throw "indexOf: expected string argument"
                "repeat":
                    let arg = args[0] else Value.Int(0)
                    match arg:
                        Value.Int(n): Value.Str(s.repeat((if n < 0: 0 else n) as uint))
                        _: throw "repeat: expected int argument"
