                    mut result = []
                    var i = 0
                    while i < pairs.length:
                        if pairs[i].0 != key:
                            result.push(pairs[i])
                        i = i + 1
                    Value.Dict(result)
                "keys":
                    mut result = []
                    var i = 0
                    while i < pairs.length:
                        result.push(pairs[i].0)
                        i = i + 1
                    Value.Array(result)
                "values":
                    mut result = []
                    var i = 0
                    while i < pairs.length:
                        result.push(pairs[i].1)
                        i = i + 1
                    Value.Array(result)
                "entries":
                    mut result = []
                    var i = 0
                    while i < pairs.length:
                        let (ek, ev) = pairs[i]
                        result.push(Value.Array([ek, ev]))
                        i = i + 1
                    Value.Array(result)
                "merge":
                    let other_val = args[0] else Value.Dict([])
                    match other_val:
                        Value.Dict(other):
                            var result = pairs
                            var i = 0
                            while i < other.length:
                                let oe = other[i]
                                var update_j = -1
                                var j = 0
                                while j < result.length:
                                    if result[j].0 == oe.0:
                                        update_j = j
                                    j = j + 1
                                if update_j >= 0:
                                    result[update_j] = oe
                                else:
                                    result.push(oe)
                                i = i + 1
                            Value.Dict(result)
                        _: throw "merge: expected dict argument"
                "isEmpty":
                    Value.Bool(pairs.length == 0)
                "filter":
                    let closure = args[0] else Value.Nil
                    mut result = []
                    var fi = 0
                    while fi < pairs.length:
                        let pk = pairs[fi].0
                        let pv = pairs[fi].1
                        let r = call_value(interp, closure, [pk, pv])
                        match r:
                            Value.Bool(b):
                                if b:
                                    result.push(pairs[fi])
                            _: throw "dict.filter: predicate must return bool"
                        fi = fi + 1
                    Value.Dict(result)
                "map":
                    let closure = args[0] else Value.Nil
                    mut result = []
                    var mi = 0
                    while mi < pairs.length:
                        let pk = pairs[mi].0
                        let pv = pairs[mi].1
                        let r = call_value(interp, closure, [pk, pv])
                        result.push((pairs[mi].0, r))
                        mi = mi + 1
                    Value.Dict(result)
                "any":
                    let closure = args[0] else Value.Nil
                    var found = false
                    var ai = 0
                    while ai < pairs.length:
                        let pk = pairs[ai].0
                        let pv = pairs[ai].1
                        let r = call_value(interp, closure, [pk, pv])
                        match r:
                            Value.Bool(true): found = true
                            _: nil
                        ai = ai + 1
                    Value.Bool(found)
                "all":
                    let closure = args[0] else Value.Nil
                    var all_ok = true
                    var alli = 0
                    while alli < pairs.length:
                        let pk = pairs[alli].0
                        let pv = pairs[alli].1
                        let r = call_value(interp, closure, [pk, pv])
                        match r:
                            Value.Bool(false): all_ok = false
                            _: nil
                        alli = alli + 1
                    Value.Bool(all_ok)
                _:
                    throw "unknown method {method_name} on {recv_type}"

        Value.Set(elements):
            match method_name:
                "clear":
                    Value.Set([])
                "length":
                    Value.Int(elements.length)
                "len":
                    Value.Int(elements.length)
                "contains" | "has":
                    let val = args[0] else Value.Nil
                    Value.Bool(value_list_contains(elements, val))
                "add" | "insert":
                    let val = args[0] else Value.Nil
                    if value_list_contains(elements, val):
                        Value.Set(elements)
                    else:
                        var result = elements
                        result.push(val)
                        Value.Set(result)
                "remove":
                    let val = args[0] else Value.Nil
                    mut result = []
                    var i = 0
                    while i < elements.length:
                        if not values_equal(elements[i], val):
                            result.push(elements[i])
                        i = i + 1
                    Value.Set(result)
                "toArray":
                    Value.Array(elements)
                # union/intersection/difference are all O(n·m): each calls
                # `.contains()` (a linear scan) once per element of `elements`.
                # Inherent to Set being a plain `[Value]`, not a hash table —
                # see value.br's `Value.Set` doc comment / docs/interpreter-
                # port-plan.md §8.3.
                "union":
                    let other_val = args[0] else Value.Set([])
                    let other = match other_val:
                        Value.Set(s): s
                        Value.Array(a): a
                        _: throw "union: expected set or array"
                    var result = elements
                    var i = 0
                    while i < other.length:
                        if not result.contains(other[i]):
                            result.push(other[i])
                        i = i + 1
                    Value.Set(result)
                "intersection":
                    let other_val = args[0] else Value.Set([])
                    let other = match other_val:
                        Value.Set(s): s
                        Value.Array(a): a
                        _: throw "intersection: expected set or array"
                    mut result = []
                    var i = 0
                    while i < elements.length:
                        if value_list_contains(other, elements[i]):
                            result.push(elements[i])
                        i = i + 1
                    Value.Set(result)
                "difference":
                    let other_val = args[0] else Value.Set([])
                    let other = match other_val:
                        Value.Set(s): s
                        Value.Array(a): a
                        _: throw "difference: expected set or array"
                    mut result = []
                    var i = 0
                    while i < elements.length:
                        if not value_list_contains(other, elements[i]):
                            result.push(elements[i])
                        i = i + 1
                    Value.Set(result)
                "isSubset":
                    let other_val = args[0] else Value.Set([])
                    let other = match other_val:
                        Value.Set(s): s
                        Value.Array(a): a
                        _: throw "isSubset: expected set or array"
                    var all_in = true
                    var i = 0
                    while i < elements.length and all_in:
                        if not value_list_contains(other, elements[i]):
                            all_in = false
                        i = i + 1
                    Value.Bool(all_in)
                "isSuperset":
                    let other_val = args[0] else Value.Set([])
                    let other = match other_val:
                        Value.Set(s): s
                        Value.Array(a): a
                        _: throw "isSuperset: expected set or array"
                    var all_in = true
                    var i = 0
                    while i < other.length and all_in:
                        if not value_list_contains(elements, other[i]):
                            all_in = false
                        i = i + 1
                    Value.Bool(all_in)
                "isEmpty":
                    Value.Bool(elements.length == 0)
                _:
                    throw "unknown method {method_name} on {recv_type}"

        Value.Int(n):
            match method_name:
                "min":
                    let mo = args[0] else Value.Nil
                    match mo:
                        Value.Int(mv): Value.Int(if mv < n: mv else n)
                        _: throw "min: expected an int"
                "max":
                    let xo = args[0] else Value.Nil
                    match xo:
                        Value.Int(xv): Value.Int(if xv > n: xv else n)
                        _: throw "max: expected an int"
                "abs":
                    if n < 0:
                        Value.Int(0 - n)
                    else:
                        Value.Int(n)
                "sqrt":
                    Value.Float64((n as float64).sqrt())
                "floor":
                    Value.Int(n)
                "ceil":
                    Value.Int(n)
                "round":
                    Value.Int(n)
                "toStr":
                    Value.Str("{n}")
                "toBin":
                    Value.Str("{n:b}")
                "toHex":
                    Value.Str("{n:x}")
                _:
                    throw "unknown method {method_name} on {recv_type}"

        Value.Uint(n):
            match method_name:
                "abs":
                    Value.Uint(n)
                "sqrt":
                    Value.Float64((n as float64).sqrt())
                "floor":
                    Value.Uint(n)
                "ceil":
                    Value.Uint(n)
                "round":
                    Value.Uint(n)
                "toStr":
                    Value.Str("{n}")
                "toBin":
                    Value.Str("{n:b}")
                "toHex":
                    Value.Str("{n:x}")
                _:
                    throw "unknown method {method_name} on {recv_type}"

        Value.Uint8(n):
            match method_name:
                "abs":
                    Value.Uint8(n)
                "sqrt":
                    Value.Float64((n as float64).sqrt())
                "floor":
                    Value.Uint8(n)
                "ceil":
                    Value.Uint8(n)
                "round":
                    Value.Uint8(n)
                "toStr":
                    Value.Str("{n}")
                "toBin":
                    Value.Str("{n:b}")
                "toHex":
                    Value.Str("{n:x}")
                _:
                    throw "unknown method {method_name} on {recv_type}"

        Value.Int8(n):
            match method_name:
                "abs": if n < 0: Value.Int8(0 - n) else: Value.Int8(n)
                "sqrt": Value.Float64((n as float64).sqrt())
                "floor": Value.Int8(n)
                "ceil": Value.Int8(n)
                "round": Value.Int8(n)
                "toStr": Value.Str("{n}")
                "toBin": Value.Str("{n:b}")
                "toHex": Value.Str("{n:x}")
                _: throw "unknown method {method_name} on {recv_type}"

        Value.Int16(n):
            match method_name:
                "abs": if n < 0: Value.Int16(0 - n) else: Value.Int16(n)
                "sqrt": Value.Float64((n as float64).sqrt())
                "floor": Value.Int16(n)
                "ceil": Value.Int16(n)
                "round": Value.Int16(n)
                "toStr": Value.Str("{n}")
                "toBin": Value.Str("{n:b}")
                "toHex": Value.Str("{n:x}")
                _: throw "unknown method {method_name} on {recv_type}"

        Value.Int32(n):
            match method_name:
                "abs": if n < 0: Value.Int32(0 - n) else: Value.Int32(n)
                "sqrt": Value.Float64((n as float64).sqrt())
                "floor": Value.Int32(n)
                "ceil": Value.Int32(n)
                "round": Value.Int32(n)
                "toStr": Value.Str("{n}")
                "toBin": Value.Str("{n:b}")
                "toHex": Value.Str("{n:x}")
                _: throw "unknown method {method_name} on {recv_type}"

        Value.Int64(n):
            match method_name:
                "abs": if n < 0: Value.Int64(0 - n) else: Value.Int64(n)
                "sqrt": Value.Float64((n as float64).sqrt())
                "floor": Value.Int64(n)
                "ceil": Value.Int64(n)
                "round": Value.Int64(n)
                "toStr": Value.Str("{n}")
                "toBin": Value.Str("{n:b}")
                "toHex": Value.Str("{n:x}")
                _: throw "unknown method {method_name} on {recv_type}"

        Value.Int128(n):
            match method_name:
                "abs": if n < 0: Value.Int128(0 - n) else: Value.Int128(n)
                "sqrt": Value.Float64((n as float64).sqrt())
                "floor": Value.Int128(n)
                "ceil": Value.Int128(n)
                "round": Value.Int128(n)
                "toStr": Value.Str("{n}")
                "toBin": Value.Str("{n:b}")
                "toHex": Value.Str("{n:x}")
                _: throw "unknown method {method_name} on {recv_type}"

        Value.Uint16(n):
            match method_name:
                "abs": Value.Uint16(n)
                "sqrt": Value.Float64((n as float64).sqrt())
                "floor": Value.Uint16(n)
                "ceil": Value.Uint16(n)
                "round": Value.Uint16(n)
                "toStr": Value.Str("{n}")
                "toBin": Value.Str("{n:b}")
                "toHex": Value.Str("{n:x}")
                _: throw "unknown method {method_name} on {recv_type}"

        Value.Uint32(n):
            match method_name:
                "abs": Value.Uint32(n)
                "sqrt": Value.Float64((n as float64).sqrt())
                "floor": Value.Uint32(n)
                "ceil": Value.Uint32(n)
                "round": Value.Uint32(n)
                "toStr": Value.Str("{n}")
                "toBin": Value.Str("{n:b}")
                "toHex": Value.Str("{n:x}")
                _: throw "unknown method {method_name} on {recv_type}"

        Value.Uint64(n):
            match method_name:
                "abs": Value.Uint64(n)
                "sqrt": Value.Float64((n as float64).sqrt())
                "floor": Value.Uint64(n)
                "ceil": Value.Uint64(n)
                "round": Value.Uint64(n)
                "toStr": Value.Str("{n}")
                "toBin": Value.Str("{n:b}")
                "toHex": Value.Str("{n:x}")
                _: throw "unknown method {method_name} on {recv_type}"

        Value.Uint128(n):
            match method_name:
                "abs": Value.Uint128(n)
                "sqrt": Value.Float64((n as float64).sqrt())
                "floor": Value.Uint128(n)
                "ceil": Value.Uint128(n)
                "round": Value.Uint128(n)
                "toStr": Value.Str("{n}")
                "toBin": Value.Str("{n:b}")
                "toHex": Value.Str("{n:x}")
                _: throw "unknown method {method_name} on {recv_type}"

        Value.Float64(f):
            match method_name:
                "atan2":
                    let a2 = args[0] else Value.Nil
                    match a2:
                        Value.Float64(y): Value.Float64(f.atan2(y))
                        Value.Float32(y): Value.Float64(f.atan2(y as float64))
                        _: throw "atan2: expected a float"
                "log":
                    let lb = args[0] else Value.Nil
                    match lb:
                        Value.Float64(b): Value.Float64(f.ln() / b.ln())
                        Value.Float32(b): Value.Float64(f.ln() / (b as float64).ln())
                        _: throw "log: expected a float base"
                "clamp":
                    let lo_v = args[0] else Value.Nil
                    let hi_v = args[1] else Value.Nil
                    guard let lo_f = value_as_float64_widened(lo_v) else: throw "clamp: expected floats"
                    guard let hi_f = value_as_float64_widened(hi_v) else: throw "clamp: expected floats"
                    Value.Float64(if f < lo_f: lo_f elif f > hi_f: hi_f else f)
                "powi":
                    let pe = args[0] else Value.Int(0)
                    match pe:
                        Value.Int(pn): Value.Float64(f.powi(pn as int32))
                        _: throw "powi: expected an int exponent"
                "trunc":
                    Value.Float64(f.trunc())
                "fract":
                    Value.Float64(f.fract())
                "min":
                    let mo = args[0] else Value.Nil
                    match mo:
                        Value.Float64(mv): Value.Float64(if mv < f: mv else f)
                        _: throw "min: expected a float"
                "max":
                    let xo = args[0] else Value.Nil
                    match xo:
                        Value.Float64(xv): Value.Float64(if xv > f: xv else f)
                        _: throw "max: expected a float"
                "pow" | "powf":
                    if args.length != 1:
                        throw "pow: expected one numeric exponent"
                    let exponent = match args[0]:
                        Value.Float64(e): e as float64
                        Value.Float32(e): e as float64
                        Value.Int(e): e as float64
                        _: throw "pow: argument must be a number"
                    Value.Float64(f.powf(exponent))
                "abs":
                    if f < 0.0:
                        Value.Float64(0.0 - f)
                    else:
                        Value.Float64(f)
                "sqrt":
                    Value.Float64(f.sqrt())
                "floor":
                    Value.Int(f.floor() as int)
                "ceil":
                    Value.Int(f.ceil() as int)
                "round":
                    Value.Int(f.round() as int)
                "toStr":
                    Value.Str("{f}")
                "toBin":
                    let fi = f.floor() as int
                    Value.Str("{fi:b}")
                "toHex":
                    let fi = f.floor() as int
                    Value.Str("{fi:x}")
                _:
                    throw "unknown method {method_name} on {recv_type}"

        # float16 sibling — transcendental/rounding ops go through f32 and
        # round back to binary16 (docs/float-width-types.md).
        Value.Float16(h):
            let f = h as float32
            match method_name:
                "pow" | "powf":
                    if args.length != 1:
                        throw "pow: expected one numeric exponent"
                    let exponent = match args[0]:
                        Value.Float64(e): e as float32
                        Value.Float32(e): e as float32
                        Value.Float16(e): e as float32
                        Value.Int(e): e as float32
                        _: throw "pow: argument must be a number"
                    Value.Float16(f.powf(exponent) as float16)
                "abs":
                    Value.Float16(f.abs() as float16)
                "sqrt":
                    Value.Float16(f.sqrt() as float16)
                "floor":
                    Value.Int(f.floor() as int)
                "ceil":
                    Value.Int(f.ceil() as int)
                "round":
                    Value.Int(f.round() as int)
                "toStr":
                    Value.Str("{h}")
                _:
                    throw "unknown method {method_name} on {recv_type}"

        # float32 sibling of the Value.Float64 block above — same method set,
        # f32 precision throughout.
        Value.Float32(f):
            match method_name:
                "atan2":
                    let a2 = args[0] else Value.Nil
                    match a2:
                        Value.Float32(y): Value.Float32(f.atan2(y))
                        Value.Float64(y): Value.Float32(f.atan2(y as float32))
                        _: throw "atan2: expected a float"
                "log":
                    let lb = args[0] else Value.Nil
                    match lb:
                        Value.Float32(b): Value.Float32(f.ln() / b.ln())
                        Value.Float64(b): Value.Float32(f.ln() / (b as float32).ln())
                        _: throw "log: expected a float base"
                "clamp":
                    let lo_v = args[0] else Value.Nil
                    let hi_v = args[1] else Value.Nil
                    guard let lo_f = value_as_float64_widened(lo_v) else: throw "clamp: expected floats"
                    guard let hi_f = value_as_float64_widened(hi_v) else: throw "clamp: expected floats"
                    let cur_f = f as float64
                    Value.Float32((if cur_f < lo_f: lo_f elif cur_f > hi_f: hi_f else cur_f) as float32)
                "powi":
                    let pe = args[0] else Value.Int(0)
                    match pe:
                        Value.Int(pn): Value.Float32(f.powi(pn as int32))
                        _: throw "powi: expected an int exponent"
                "trunc":
                    Value.Float32(f.trunc())
                "fract":
                    Value.Float32(f.fract())
                "pow" | "powf":
                    if args.length != 1:
                        throw "pow: expected one numeric exponent"
                    let exponent = match args[0]:
                        Value.Float64(e): e as float32
                        Value.Float32(e): e as float32
                        Value.Int(e): e as float32
                        _: throw "pow: argument must be a number"
                    Value.Float32(f.powf(exponent))
                "abs":
                    if f < 0.0:
                        Value.Float32(0.0 - f)
                    else:
                        Value.Float32(f)
                "sqrt":
                    Value.Float32(f.sqrt())
                "floor":
                    Value.Int(f.floor() as int)
                "ceil":
                    Value.Int(f.ceil() as int)
                "round":
                    Value.Int(f.round() as int)
                "toStr":
                    Value.Str("{f}")
                "toBin":
                    let fi = f.floor() as int
                    Value.Str("{fi:b}")
                "toHex":
