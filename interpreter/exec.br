# == EXEC AND CALL ==

# ─── exec_block ───────────────────────────────────────────────────────────────

def Signal? exec_block(mut Interpreter interp, [Stmt] stmts):
    for stmt in stmts:
        let Signal? sig = exec_stmt(interp, stmt)
        if sig != nil:
            return sig
    nil

# Like exec_block but treats the last Stmt::Expr as an implicit return value
def Signal? exec_block_do(mut Interpreter interp, [Stmt] stmts):
    let n = stmts.length
    var i = 0
    while i < n:
        let stmt = stmts[i]
        if i == n - 1:
            match stmt:
                Stmt.Expr(e):
                    let val = eval_expr(interp, e)
                    if interp.has_pending_return:
                        return nil
                    return YieldSignal(val, 0)
                Stmt.If(s):
                    return exec_if_as_do(interp, s)
                Stmt.IfLet(s):
                    return exec_if_let_as_do(interp, s)
                _:
                    let sig = exec_stmt(interp, stmt)
                    if sig != nil:
                        return sig
        else:
            let sig = exec_stmt(interp, stmt)
            if sig != nil:
                return sig
        i = i + 1
    nil

# An if-let in tail position of a `do:` block yields its selected branch's value
# (this is what `if let v = o: a else: b` as an expression desugars to).
def Signal? exec_if_let_as_do(mut Interpreter interp, IfLetStmt s):
    let parent = interp.current_env
    let matched = exec_if_let_match(interp, s.clauses)
    var Signal? result = nil
    if matched:
        result = exec_block_do(interp, s.then_body)
    else:
        if let body = s.else_body:
            mut child = new_env(parent.clone())
            interp.current_env = child
            result = exec_block_do(interp, body)
    interp.current_env = parent
    result

def Signal? exec_if_as_do(mut Interpreter interp, IfStmt s):
    for branch in s.branches:
        let cond_val = eval_expr(interp, branch.cond)
        let b = expect_bool(cond_val)
        if b:
            mut child = new_env(interp.current_env)
            let prev = interp.current_env
            interp.current_env = child
            let sig = exec_block_do(interp, branch.body)
            interp.current_env = prev
            if sig != nil:
                return sig
            return nil
    if let else_body = s.else_body:
        mut child = new_env(interp.current_env)
        let prev = interp.current_env
        interp.current_env = child
        let sig = exec_block_do(interp, else_body)
        interp.current_env = prev
        if sig != nil:
            return sig
    nil

def Signal? exec_if_as_expr(mut Interpreter interp, IfStmt s):
    for branch in s.branches:
        let cond_val = eval_expr(interp, branch.cond)
        let b = expect_bool(cond_val)
        if b:
            mut child = new_env(interp.current_env)
            let prev = interp.current_env
            interp.current_env = child
            let sig = exec_block_fn(interp, branch.body)
            interp.current_env = prev
            if sig != nil:
                return sig
            return ReturnSignal(Value.Nil)
    if let else_body = s.else_body:
        mut child = new_env(interp.current_env)
        let prev = interp.current_env
        interp.current_env = child
        let sig = exec_block_fn(interp, else_body)
        interp.current_env = prev
        if sig != nil:
            return sig
        return ReturnSignal(Value.Nil)
    ReturnSignal(Value.Nil)

# Consumes a pending throw (preferred) or pending return left by an expression evaluated for
# its value (`let v = match ...`, `loop`, a throwing call) and turns it into a Signal so the
# statement can stop instead of carrying on with a placeholder Nil.
def Signal? take_pending_signal(mut Interpreter interp):
    if interp.has_pending_throw:
        interp.has_pending_return = false
        interp.pending_return_val = Value.Nil
        return ThrowSignal(interp.take_pending_throw())
    if interp.has_pending_return:
        let rv = interp.pending_return_val
        interp.has_pending_return = false
        interp.pending_return_val = Value.Nil
        return ReturnSignal(rv)
    nil

def Signal? exec_match_as_expr(mut Interpreter interp, MatchStmt s):
    let subject = eval_expr(interp, s.subject)
    let result = eval_match(interp, subject, s.arms)
    # A `return`/`throw` inside an arm block surfaces as a pending return/throw.
    if interp.has_pending_throw:
        return ThrowSignal(interp.take_pending_throw())
    if interp.has_pending_return:
        let rv = interp.pending_return_val
        interp.has_pending_return = false
        interp.pending_return_val = Value.Nil
        return ReturnSignal(rv)
    ReturnSignal(result)

def Signal? exec_block_fn(mut Interpreter interp, [Stmt] stmts):
    mut [[Stmt]] defers = []
    let n = stmts.length
    var i = 0
    var Signal? final_sig = nil
    while i < n:
        let stmt = stmts[i]
        match stmt:
            Stmt.Defer(body):
                defers.push(body)
            _:
                if i == n - 1:
                    match stmt:
                        Stmt.Expr(e):
                            let val = eval_expr(interp, e)
                            if interp.has_pending_throw:
                                final_sig = ThrowSignal(interp.take_pending_throw())
                            else:
                                final_sig = ReturnSignal(val)
                        Stmt.If(s):
                            final_sig = exec_if_as_expr(interp, s)
                        Stmt.Match(s):
                            final_sig = exec_match_as_expr(interp, s)
                        Stmt.IfLet(s):
                            final_sig = exec_if_let_as_expr(interp, s)
                        _:
                            let sig = exec_stmt(interp, stmt)
                            if sig != nil:
                                final_sig = sig
                else:
                    let sig = exec_stmt(interp, stmt)
                    if sig != nil:
                        final_sig = sig
        if final_sig != nil:
            break
        i = i + 1
    if defers.length > 0:
        var di = defers.length - 1
        while di >= 0:
            _ = exec_block(interp, defers[di])
            di = di - 1
    final_sig

# An if-let in tail position returns its selected branch's value.
def Signal? exec_if_let_as_expr(mut Interpreter interp, IfLetStmt s):
    let parent = interp.current_env
    let matched = exec_if_let_match(interp, s.clauses)
    var Signal? result = nil
    if matched:
        result = exec_block_fn(interp, s.then_body)
    else:
        if let body = s.else_body:
            mut child = new_env(parent.clone())
            interp.current_env = child
            result = exec_block_fn(interp, body)
    interp.current_env = parent
    if result != nil:
        return result
    ReturnSignal(Value.Nil)

# Conditional numeric casts are checked; ordinary `as` still truncates.
# Cast once, then check signs and round-trip to detect loss of integer range.
def Value eval_cond_binding(mut Interpreter interp, Expr expr):
    match expr.kind:
        ExprKind.Cast(inner, ty):
            let original = eval_expr(interp, inner)
            let converted = cast_value(interp, original, ty)
            if let source_kind = num_kind_of(original):
                if let target_kind = type_to_num_kind(ty):
                    let original_int = value_as_i128(original) else (0 as int128)
                    let converted_int = value_as_i128(converted) else (0 as int128)
                    if num_kind_signed(source_kind) and not num_kind_signed(target_kind) and original_int < 0:
                        return Value.Nil
                    if not num_kind_signed(source_kind) and num_kind_signed(target_kind) and converted_int < 0:
                        return Value.Nil
                    let restored = i128_to_kind(source_kind, converted_int)
                    if not values_equal(original, restored):
                        return Value.Nil
            converted
        _: eval_expr(interp, expr)

def Value eval_cond_in_env(mut Interpreter interp, Env'actor env, Expr expr):
    let parent = interp.current_env
    interp.current_env = env
    let value = eval_cond_binding(interp, expr)
    interp.current_env = parent
    value

# ─── exec_stmt ────────────────────────────────────────────────────────────────

# Remembers the declared type of a `let` (or that it holds a built-in optional) for `{x:?}`.
def void record_let_type(mut Interpreter interp, LetStmt s):
    mut {string=Type} dt = interp.declared_types
    # Keyed by call depth, so a same-named local of another function never shares the entry.
    let depth_now = interp.return_ty_stack.length
    let dkey = "{depth_now}:{s.name}"
    if let ty = s.ty:
        dt.set(dkey, ty)
    else:
        var is_opt = false
        if let e = s.value:
            is_opt = expr_is_builtin_optional(e)
        if is_opt:
            dt.set(dkey, Type.Optional(Type.Named("_")))
        else:
            dt.remove(dkey)
    interp.declared_types = dt

def Signal? exec_stmt(mut Interpreter interp, Stmt stmt):
    match stmt:
        Let(s):
            record_let_type(interp, s)
            mark_alias_binding(interp, s.name, s.ty)
            var val = Uninitialized
            var string? move_source = nil
            if let expr = s.value:
                match expr.kind:
                    ExprKind.Var(src): move_source = some(src)
                    _: nil
                val = eval_expr(interp, expr)
                let pending_sig = take_pending_signal(interp)
                if pending_sig != nil:
                    return pending_sig
                # Note: move semantics not enforced in interpreter — all values treated as copyable
                # Coerce int literals/values to the declared uint/uint8 type — the parser
                # already recognizes these annotations, but nothing applied them at runtime.
                if let declared_ty = s.ty:
                    check_fixed_declared(declared_ty, expr, val, "assign", s.name)
                    if type_is_observed(declared_ty):
                        val = coerce_declared_value(interp, val, declared_ty)
                    match declared_ty:
                        Type.Uint:
                            match val:
                                Value.Uint(_): nil
                                _: val = cast_value(interp, val, Type.Uint)
                        Type.Uint8:
                            match val:
                                Value.Uint8(_): nil
                                _: val = cast_value(interp, val, Type.Uint8)
                        Type.Int8 | Type.Int16 | Type.Int32 | Type.Int64 | Type.Int128 | Type.Uint16 | Type.Uint32 | Type.Uint64 | Type.Uint128:
                            if num_kind_of(val) != type_to_num_kind(declared_ty):
                                val = cast_value(interp, val, declared_ty)
                        # float has no independent flexible kind of its own the way
                        # int/uint do (docs/float-width-types.md §2) — a bare literal
                        # defaults to Value.Float64, so `let float32 x = 1.0` needs
                        # the same narrowing coercion int8..int128 above get, keyed
                        # directly off the Value variant instead of NumKind (which
                        # floats deliberately aren't part of).
                        Type.Float16:
                            match val:
                                Value.Float16(_): nil
                                _: val = cast_value(interp, val, Type.Float16)
                        Type.Float32:
                            match val:
                                Value.Float32(_): nil
                                _: val = cast_value(interp, val, Type.Float32)
                        Type.Float64:
                            match val:
                                Value.Float64(_): nil
                                _: val = cast_value(interp, val, Type.Float64)
                        # `let fixed16_16 x = 1.5` / `= 3`: an untyped literal takes the format.
                        Type.Named(fixed_tname):
                            val = coerce_declared_value(interp, val, declared_ty)
                        # `var float32 x = 0.0` parses as Qualified(Float32, BorrowMut)
                        # (apply_var_to_borrow) — unwrap so it gets the same narrowing.
                        Type.Qualified(inner_ty, _):
                            match inner_ty:
                                Type.Float16:
                                    match val:
                                        Value.Float16(_): nil
                                        _: val = cast_value(interp, val, Type.Float16)
                                Type.Float32:
                                    match val:
                                        Value.Float32(_): nil
                                        _: val = cast_value(interp, val, Type.Float32)
                                Type.Float64:
                                    match val:
                                        Value.Float64(_): nil
                                        _: val = cast_value(interp, val, Type.Float64)
                                Type.Named(fixed_tname):
                                    val = coerce_declared_value(interp, val, inner_ty)
                                _: nil
                        # A fixed-shape `let [T, width = W, height = H] a = [...]`
                        # annotation is the only place a labeled array's shape can
                        # come from a bare array literal (a comprehension or
                        # `.reshape()` initializer already produces a real
                        # Value.LabeledArray on its own — see eval.br). Dynamic-
                        # shape annotations (`let [T, width, height] a`) have no
                        # sizes to attach here; those stay Value.Array until a
                        # later `.reshape()`/assignment gives them a shape.
                        Type.LabeledArray(_, axes):
                            mut pairs = []
                            var all_fixed = true
                            var total = 1
                            for ax in axes:
                                if let sz = ax.size:
                                    pairs.push((ax.label, sz))
                                    total = total * sz
                                else:
                                    all_fixed = false
                            if all_fixed:
                                match val:
                                    Value.Array(items):
                                        if items.length != total:
                                            throw "labeled array length mismatch — buffer has {items.length} elements, shape needs {total}"
                                        val = Value.LabeledArray(items, pairs)
                                    _: nil
                        _: nil
            if s.is_lazy:
                interp.current_env.define_lazy(s.name)
            elif s.mutable:
                interp.current_env.define_mut(s.name, val)
            else:
                interp.current_env.define(s.name, val)
            nil

        If(s):
            exec_if(interp, s)

        While(s):
            exec_while(interp, s)

        For(s):
            exec_for(interp, s)

        Match(s):
            exec_match_stmt(interp, s)

        Return(s):
            var val = Nil
            if let expr = s.value:
                # `return .Left` — resolve against the enclosing function's own declared
                # return type (current_return_ty, pushed by call_fn) instead of
                # eval_dot_ident's ambiguous-scan default, mirroring the Rust
                # interpreter's exec.rs Stmt::Return fix.
                var hinted = false
                match expr.kind:
                    ExprKind.DotIdent(variant_name):
                        let hint_opt = current_return_ty(interp)
                        if let hint = hint_opt:
                            let resolved = eval_dot_ident_hint(interp, variant_name, hint)
                            if let rv = resolved:
                                val = rv
                                hinted = true
                    _: nil
                if not hinted:
                    val = eval_expr(interp, expr)
                let pending_sig = take_pending_signal(interp)
                if pending_sig != nil:
                    return pending_sig
            ReturnSignal(val)

        Break(line, value_expr):
            var break_val = Void
            if let expr = value_expr:
                break_val = eval_expr(interp, expr)
            BreakSignal(break_val)

        Continue:
            ContinueSignal

        Yield(expr, _):
            let yv = eval_expr(interp, expr)
            if interp.in_stream_fn:
                var sy = interp.stream_yields
                sy.push(yv)
                interp.stream_yields = sy
                nil
            else:
                YieldSignal(yv, 0)

        Throw(s):
            var val = Nil
            if let expr = s.value:
                val = eval_expr(interp, expr)
            else:
                let err = interp.current_env.get("error")
                val = err else Nil
            ThrowSignal(val)

        Try(s):
            exec_try(interp, s)

        DoWhile(s):
            exec_do_while(interp, s)

        Expr(expr):
            eval_expr(interp, expr)
            if interp.has_pending_throw:
                interp.has_pending_return = false
                interp.pending_return_val = Value.Nil
                return ThrowSignal(interp.take_pending_throw())
            if interp.has_pending_return:
                let v = interp.pending_return_val
                interp.has_pending_return = false
                interp.pending_return_val = Value.Nil
                return ReturnSignal(v)
            nil

        Guard(s):
            let cond_val = match s.cond:
                GuardCond.Expr(e): eval_expr(interp, e)
                GuardCond.Clauses(clauses):
                    var all_true = true
                    var ci = 0
                    while ci < clauses.length and all_true:
                        let clause = clauses[ci]
                        match clause:
                            CondClause.Expr(e):
                                if not val_to_bool(eval_expr(interp, e)):
                                    all_true = false
                            CondClause.Let(name, e):
                                let v = eval_cond_binding(interp, e)
                                match v:
                                    Value.Nil: all_true = false
                                    _: interp.current_env.define(name, v)
                            _: nil
                        ci = ci + 1
                    Value.Bool(all_true)
            let passed = val_to_bool(cond_val)
            if not passed:
                mut child = new_env(interp.current_env)
                let prev = interp.current_env
                interp.current_env = child
                let sig = exec_block(interp, s.else_body)
                interp.current_env = prev
                if sig != nil:
                    return sig
            nil

        LetDestructure(s):
            let val = eval_expr(interp, s.value)
            let pending_sig = take_pending_signal(interp)
            if pending_sig != nil:
                return pending_sig
            var elems = []
            match val:
                Value.Tuple(items): elems = items
                Value.Array(items): elems = items
                _: elems = [val]
            var i = 0
            for binding in s.bindings:
                if binding.name == "_":
                    i = i + 1
                    continue
                let v = elems[i] else Value.Nil
                if s.mutable:
                    interp.current_env.define_mut(binding.name, v)
                else:
                    interp.current_env.define(binding.name, v)
                i = i + 1
            nil

        Loop(s):
            exec_loop(interp, s)

        IfLet(s):
            exec_if_let(interp, s)

        WhileLet(s):
            exec_while_let(interp, s)

        Fn(decl):
            # Nested function declaration — register in current scope. Upgrades to a
            # Value.OverloadedFn when a same-named function already exists in this
            # local scope (see register_free_fn, stdlib.br). `interp.current_env` is
            # read into its own statement first — see the matching comment at
            # stdlib.br's Item.Fn case for why inlining it as a call argument
            # self-deadlocks.
            mut cenv = interp.current_env
            register_free_fn(interp, cenv, decl)
            nil

        Struct(decl):
            # Nested struct declaration
            let sname = decl.name
            interp.set_struct_decl(sname, decl)
            interp.set_method_decls(sname, decl.methods)
            interp.current_env.define(sname, Value.StructDef(sname))
            nil

        Enum(decl):
            # Nested enum declaration
            let ename = decl.name
            interp.set_enum_decl(ename, decl)
            interp.set_method_decls(ename, decl.methods)
            interp.current_env.define(ename, Value.EnumDef(ename))
            nil

        Mod(decl):
            for sub_item in decl.items:
                exec_item(interp, sub_item)
            nil

        KernelBlock(body, _):
            exec_kernel_block(interp, body)

        With(s):
            # No-op wrapper here: this tree-walk interpreter has no host/device
            # split and no per-call lock semantics to simulate, so every qualifier
            # `with` exists for already behaves as a plain value — same precedent
            # as every kernel-context qualifier already being a no-op in this
            # interpreter. See docs/scoped-access-blocks.md, "Cross-target behavior".
            mut child = new_env(interp.current_env)
            let prev = interp.current_env
            interp.current_env = child
            let sig = exec_block(interp, s.body)
            interp.current_env = prev
            sig

        _: nil

# ─── exec_if_let ──────────────────────────────────────────────────────────────

def Signal? exec_if_let(mut Interpreter interp, IfLetStmt s):
    let parent = interp.current_env
    let all_matched = exec_if_let_match(interp, s.clauses)
    if all_matched:
        let sig = exec_block(interp, s.then_body)
        interp.current_env = parent
        return sig
    if let else_stmts = s.else_body:
        return exec_block(interp, else_stmts)
    nil

def Value eval_in_env(mut Interpreter interp, Env'actor env, Expr expr):
    let prev = interp.current_env
    interp.current_env = env
    let v = eval_expr(interp, expr)
    interp.current_env = prev
    v

def bool exec_if_let_match(mut Interpreter interp, [CondClause] clauses):
    # Evaluate all bindings in the parent scope, populate child env
    mut child = new_env(interp.current_env)
    var all_matched = true
    var ci = 0
    while all_matched and ci < clauses.length:
        let clause = clauses[ci]
        ci = ci + 1
        match clause:
            CondClause.Let(name, expr):
                let v = eval_cond_in_env(interp, child, expr)
                match v:
                    Value.Nil: all_matched = false
                    _: child.define(name, v)
            CondClause.LetPat(pat, expr):
                let v = eval_cond_in_env(interp, child, expr)
                if not match_pattern(v, pat, child, interp):
                    all_matched = false
                else:
                    # `if let _ = opt:` is a presence test: an absent optional (nil) does not match.
                    match pat:
                        Pattern.Wildcard:
                            match v:
                                Value.Nil: all_matched = false
                                _: nil
                        _: nil
            CondClause.Expr(expr):
                # guard: eval in child context via helper (forces Arc::clone at call site)
                let gv = eval_in_env(interp, child, expr)
                if not val_to_bool(gv):
                    all_matched = false
    if all_matched:
        interp.current_env = child
    all_matched

# ─── exec_while_let ───────────────────────────────────────────────────────────

def Signal? exec_while_let_pattern(mut Interpreter interp, Pattern pattern, Expr value_expr, [Stmt] body):
    while true:
        let v = eval_expr(interp, value_expr)
        mut child = new_env(interp.current_env)
        if not match_pattern(v, pattern, child, interp):
            break
        let prev = interp.current_env
        interp.current_env = child
        let sig = exec_block(interp, body)
        interp.current_env = prev
        match sig:
            BreakSignal(_): return nil
            ReturnSignal(rv): return ReturnSignal(rv)
            ThrowSignal(tv): return ThrowSignal(tv)
            _: nil
    nil

def Signal? exec_while_let_simple(mut Interpreter interp, string name, Expr value_expr, [Stmt] body):
    while true:
        let v = eval_expr(interp, value_expr)
        match v:
            Value.Nil: break
            _:
                mut child = new_env(interp.current_env)
                child.define(name, v)
                let prev = interp.current_env
                interp.current_env = child
                let sig = exec_block(interp, body)
                interp.current_env = prev
                match sig:
                    BreakSignal(_): return nil
                    ReturnSignal(rv): return ReturnSignal(rv)
                    ThrowSignal(tv): return ThrowSignal(tv)
                    _: nil
    nil

# Self-referencing shorthand: `while let v:` ≡ `while let v = v:` (book.md).
# The condition and the loop body's `v` are the SAME outer binding — unlike
# exec_while_let_simple above, don't shadow it in a per-iteration child scope,
# or a body reassignment (the documented idiom for advancing to the next
# value) would write to a shadow discarded at the end of the iteration instead
# of the binding the next condition check reads, hanging the loop forever.
# Mirrors the main tree-walk interpreter's exec_while_let (src/interpreter/exec.rs).
def Signal? exec_while_let_self_shorthand(mut Interpreter interp, string name, Expr value_expr, [Stmt] body):
    while true:
        let v = eval_expr(interp, value_expr)
        match v:
            Value.Nil: break
            _:
                interp.current_env.set(name, v)
                mut child = new_env(interp.current_env)
                let prev = interp.current_env
                interp.current_env = child
                let sig = exec_block(interp, body)
                interp.current_env = prev
                match sig:
                    BreakSignal(_): return nil
                    ReturnSignal(rv): return ReturnSignal(rv)
                    ThrowSignal(tv): return ThrowSignal(tv)
                    _: nil
    nil

def bool is_self_shorthand_value(Expr value_expr, string name):
    match value_expr.kind:
        ExprKind.Var(vname): vname == name
        _: false

def Signal? exec_while_let(mut Interpreter interp, WhileLetStmt s):
    if let pattern = s.pattern:
        exec_while_let_pattern(interp, pattern, s.value, s.body)
    elif is_self_shorthand_value(s.value, s.name):
        exec_while_let_self_shorthand(interp, s.name, s.value, s.body)
    else:
        exec_while_let_simple(interp, s.name, s.value, s.body)

# ─── exec_loop ────────────────────────────────────────────────────────────────

def Signal? exec_loop(mut Interpreter interp, LoopStmt s):
    while true:
        mut child = new_env(interp.current_env)
        let prev = interp.current_env
        interp.current_env = child
        let sig = exec_block(interp, s.body)
        interp.current_env = prev
        match sig:
            BreakSignal(_): return nil
            ReturnSignal(v): return ReturnSignal(v)
            ThrowSignal(v): return ThrowSignal(v)
            _: nil
    nil

# ─── exec_do_while ────────────────────────────────────────────────────────────

def Signal? exec_do_while(mut Interpreter interp, DoWhileStmt s):
    while true:
        mut child = new_env(interp.current_env)
        let prev = interp.current_env
        interp.current_env = child
        let sig = exec_block(interp, s.body)
        interp.current_env = prev
        match sig:
            BreakSignal(_): return nil
            ReturnSignal(v): return ReturnSignal(v)
            ThrowSignal(v): return ThrowSignal(v)
            _: nil
        let cond_val = eval_expr(interp, s.condition)
        let cond = expect_bool(cond_val)
        if not cond:
            break
    nil

# ─── exec_if ──────────────────────────────────────────────────────────────────

def Signal? exec_if(mut Interpreter interp, IfStmt s):
    for branch in s.branches:
        let cond_val = eval_expr(interp, branch.cond)
        let cond_sig = take_pending_signal(interp)
        if cond_sig != nil:
            return cond_sig
        let b = expect_bool(cond_val)
        if b:
            mut child = new_env(interp.current_env)
            let prev = interp.current_env
            interp.current_env = child
            let sig = exec_block(interp, branch.body)
            drop_scope_subscriptions(interp, child, -1)
            interp.current_env = prev
            return sig
    if let else_body = s.else_body:
        mut child = new_env(interp.current_env)
        let prev = interp.current_env
        interp.current_env = child
        let sig = exec_block(interp, else_body)
        interp.current_env = prev
        return sig
    nil

# ─── exec_while ───────────────────────────────────────────────────────────────

def Signal? exec_while(mut Interpreter interp, WhileStmt s):
    var running = true
    var Signal? result = nil
    while running:
        let cond_val = eval_expr(interp, s.condition)
        let cond_sig = take_pending_signal(interp)
        if cond_sig != nil:
            return cond_sig
        let b = expect_bool(cond_val)
        if not b:
            running = false
        else:
            mut child = new_env(interp.current_env)
            let prev = interp.current_env
            interp.current_env = child
            let sig = exec_block(interp, s.body)
            interp.current_env = prev
            match sig:
                nil: nil
                BreakSignal(_): running = false
                ContinueSignal: nil
                _:
                    running = false
                    result = sig
    result

# ─── exec_for ─────────────────────────────────────────────────────────────────

def Signal? exec_for(mut Interpreter interp, ForStmt s):
    let iterable = eval_expr(interp, s.iterable)
    # A throwing call as the iterable (e.g. a `throws` stream method) ends the loop with its error.
    if interp.has_pending_throw:
        return ThrowSignal(interp.take_pending_throw())
    let items = collect_iterable_with_interp(interp, iterable)
    var Signal? result = nil
    var idx = 0
    var done = false
    while not done and idx < items.length:
        let item = items[idx]
        idx = idx + 1
        mut child = new_env(interp.current_env)
        let vars = s.vars
        if vars.length == 1:
            child.define_mut(vars[0], item)
        else:
            match item:
                Tuple(elems):
                    var i = 0
                    for v in vars:
                        let val = if i < elems.length: elems[i] else: Value.Nil
                        child.define_mut(v, val)
                        i = i + 1
                _:
                    child.define_mut(vars[0], Int(idx - 1))
                    if vars.length >= 2:
                        child.define_mut(vars[1], item)
        let prev = interp.current_env
        interp.current_env = child

        var skip = false
        if let where_e = s.where_expr:
            let cond_val = eval_expr(interp, where_e)
            let cond_sig = take_pending_signal(interp)
            if cond_sig != nil:
                interp.current_env = prev
                return cond_sig
            if not expect_bool(cond_val):
                skip = true

        if not skip:
            let sig = exec_block(interp, s.body)
            match sig:
                nil: nil
                BreakSignal(_): done = true
                ContinueSignal: nil
                _:
                    done = true
                    result = sig

        interp.current_env = prev
    result

# ─── collect_iterable ─────────────────────────────────────────────────────────

def [Value] collect_iterable(Value val):
    match val:
        Array(elems): elems
        Set(elems): elems
        Tuple(elems): elems
        Value.Dict(pairs):
            mut out = []
            for p in pairs:
                out.push(Tuple([p.0, p.1]))
            out
        Range(start, end, inclusive, _):
            mut out = []
            var i = start
            let limit = if inclusive: end + 1 else: end
            while i < limit:
                out.push(Int(i))
                i = i + 1
            out
        Str(s):
            mut out = []
            for c in s.chars():
                out.push(Value.Str(c))
            out
        _: throw "value is not iterable"

def [Value] collect_iterable_with_interp(mut Interpreter interp, Value val):
    match val:
        Value.Object(inner):
            if inner.type_name == "__ChannelRx__":
                let ch_id_opt = inner.get_field("__ch_id__")
                if let ch_id_val = ch_id_opt:
                    let ch_key = match ch_id_val:
                        Value.Str(s): s
                        _: ""
                    if ch_key != "":
                        let queue_opt = interp.channel_queues.get(ch_key)
                        if let q = queue_opt:
                            return q
                return []
            var has_next = false
            if let sd = interp.get_struct_decl(inner.type_name):
                for m in sd.methods:
                    if m.name == "next":
                        has_next = true
            if has_next:
                mut [Value] items = []
                var iter_val = val
                var done = false
                while not done:
                    let item = call_method(interp, iter_val, "next", [])
                    if interp.has_pending_throw:
                        throw interp.take_pending_throw()
                    match item:
                        Value.Nil: done = true
                        _: items.push(item)
                return items
            throw "value is not iterable"
        _: collect_iterable(val)

# ─── exec_match_stmt ──────────────────────────────────────────────────────────

def Signal? exec_match_stmt(mut Interpreter interp, MatchStmt s):
    let subject = eval_expr(interp, s.subject)
    var matched = false
    var Signal? result = nil
    var arm_idx = 0
    while not matched and arm_idx < s.arms.length:
        let arm = s.arms[arm_idx]
        arm_idx = arm_idx + 1
        var pat_idx = 0
        while not matched and pat_idx < arm.patterns.length:
            let pattern = arm.patterns[pat_idx]
            pat_idx = pat_idx + 1
            mut child = new_env(interp.current_env)
            let did_match = match_pattern(subject, pattern, child, interp)
            if did_match:
                var guard_ok = true
                if let guard_expr = arm.match_guard:
                    let gprev = interp.current_env
                    interp.current_env = child.clone()
                    let gv = eval_expr(interp, guard_expr)
                    interp.current_env = gprev
                    guard_ok = expect_bool(gv)
                if guard_ok:
                    matched = true
                    let prev = interp.current_env
                    interp.current_env = child
                    let sig = match arm.body:
                        MatchBody.Expr(e):
                            eval_expr(interp, e)
                            nil
                        MatchBody.Block(stmts):
                            exec_block(interp, stmts)
                    interp.current_env = prev
                    result = sig
    result

# ─── match_pattern ────────────────────────────────────────────────────────────

# Looks up the declared EnumVariant for a runtime EnumVariant value's (type, variant)
# pair, so match_pattern can tell whether a given field position was declared `mut Type`
# (docs/mut-type-modifier.md, `VariantField.is_mut`) and bind it content-mutable
# accordingly — mirrors the Rust interpreter's match_pattern (src/interpreter/methods.rs).
req EnumVariant? find_enum_variant_decl(Interpreter interp, string type_name, string variant_name):
    if let decl = interp.get_enum_decl(type_name):
        for v in decl.variants:
            if v.name == variant_name:
                return v
    nil

req [bool] enum_variant_field_mut_flags(EnumVariant? variant_decl):
    mut [bool] flags = []
    if let vdecl = variant_decl:
        for f in vdecl.fields:
            flags.push(f.is_mut)
    flags

# Binds one enum-variant field's value against its sub-pattern. A direct `Pattern.Bind`
# is handled here rather than through the general recursive `match_pattern` call so it can
# consult `field_is_mut` and call `env.define_mut` instead of the always-immutable
# `env.define` a bare recursive call would use — every other sub-pattern shape (nested
# Variant, Tuple, literal, ...) falls through to the ordinary recursive match unchanged.
def bool bind_variant_field(Value fval, Pattern fpat, mut Env'actor env, Interpreter interp, bool field_is_mut):
    match fpat:
        Pattern.Bind(bname):
            if field_is_mut:
                env.define_mut(bname, fval)
            else:
                env.define(bname, fval)
            true
        _:
            match_pattern(fval, fpat, env, interp)

def bool match_pattern(Value val, Pattern pattern, mut Env'actor env, Interpreter interp):
    match pattern:
        Pattern.Wildcard:
            true
        Pattern.Bind(name):
            env.define(name, val)
            true
        Pattern.None:
            match val:
                Value.Nil: true
                Value.EnumVariant(stype, svariant, sfields):
                    svariant == "None" or svariant == "none"
                _: false
        Pattern.Some(inner):
            match val:
                Value.Nil: false
                Value.EnumVariant(stype, svariant, sfields):
                    if svariant == "Some" or svariant == "some":
                        if sfields.length == 1:
                            match_pattern(sfields[0], inner, env, interp)
                        else:
                            match_pattern(Value.Tuple(sfields), inner, env, interp)
                    else:
                        false
                _: match_pattern(val, inner, env, interp)
        Pattern.Lit(lit):
            match lit:
                LitPattern.Int(n):
                    match val:
                        Value.Int(v): v == n
                        _: false
                LitPattern.Float(f):
                    match val:
                        Value.Float64(v): v == f
                        Value.Float16(v): (v as float64) == f
                        Value.Float32(v): (v as float64) == f
                        _: false
                LitPattern.Str(s):
                    match val:
                        Value.Str(v): v == s
                        _: false
                LitPattern.Bool(b):
                    match val:
                        Value.Bool(v): v == b
                        _: false
                LitPattern.Nil:
                    match val:
                        Value.Nil: true
                        _: false
        Pattern.Tuple(pats):
            match val:
                Value.Tuple(elems):
                    if elems.length != pats.length:
                        false
                    else:
                        var ok = true
                        var i = 0
                        while ok and i < pats.length:
                            ok = match_pattern(elems[i], pats[i], env, interp)
                            i = i + 1
                        ok
                _: false
        Pattern.Variant(variant_name, field_pats):
            match val:
                Value.EnumVariant(vtype, vvariant, vfields):
                    let full = if vtype.length > 0: "{vtype}.{vvariant}" else: vvariant
                    if full != variant_name and vvariant != variant_name:
                        false
                    else:
                        let field_muts = enum_variant_field_mut_flags(find_enum_variant_decl(interp, vtype, vvariant))
                        var ok = true
                        var i = 0
                        while ok and i < field_pats.length:
                            let fval = if i < vfields.length: vfields[i] else: Value.Nil
                            let field_is_mut = if i < field_muts.length: field_muts[i] else: false
                            ok = bind_variant_field(fval, field_pats[i], env, interp, field_is_mut)
                            i = i + 1
                        ok
                _: false

# ─── exec_try ─────────────────────────────────────────────────────────────────

def Signal? exec_try(mut Interpreter interp, TryStmt s):
    mut child = new_env(interp.current_env)
    let prev = interp.current_env
    interp.current_env = child
    let body_sig = exec_block(interp, s.body)
    interp.current_env = prev
    # Check pending throw from function calls
    var Value? exc_val_opt = nil
    match body_sig:
        ThrowSignal(v): exc_val_opt = v
        _: nil
    if exc_val_opt == nil and interp.has_pending_throw:
        exc_val_opt = interp.take_pending_throw()
    if let exc_val = exc_val_opt:
        let exc_type = value_type_name(exc_val)
        var string? exc_variant = nil
        match exc_val.clone():
            Value.EnumVariant(_, variant, _): exc_variant = variant
            _: nil
        var handled = false
        var clause_idx = 0
        while not handled and clause_idx < s.catch_clauses.length:
            let clause = s.catch_clauses[clause_idx]
            clause_idx = clause_idx + 1
            let catch_types = clause.types
            let num_types = catch_types.length
            var type_matches = false
            for ct in catch_types:
                if ct == exc_type or normalize_type_name(ct) == exc_type:
                    type_matches = true
            var variant_matches = true
            if let wanted_variant = clause.variant:
                variant_matches = false
                if let actual_variant = exc_variant.clone():
                    variant_matches = actual_variant == wanted_variant
            let matches = (num_types == 0 or type_matches) and variant_matches
            if matches:
                handled = true
                mut cenv = new_env(interp.current_env)
                cenv.define("error", exc_val)
                let cprev = interp.current_env
                interp.current_env = cenv
                let csig = exec_block(interp, clause.body)
                interp.current_env = cprev
                return csig
        if not handled:
            return ThrowSignal(exc_val)
        nil
    else:
        body_sig

# ─── kernels ─────────────────────────────────────────────────────────────────────
# `kernel K:` is a struct whose anonymous `def ():` (the method `__call__`) is the per-thread body.
# `k(block = B, grid = G)` runs it for every thread of every block, sequentially: the fields live in
# one shared scope, each thread has its own child scope (its `let`s, `.thread`/`.block`/`.grid`), and
# a top-level `sync` splits the body into phases that every thread of a block finishes before the next.

def (int, int, int) kernel_dims(Value v):
    match v:
        Value.Int(n): (n, 1, 1)
        Value.Uint(n): (n as int, 1, 1)
        Value.Tuple(items):
            var kx = 1
            var ky = 1
            var kz = 1
            var ki = 0
            while ki < items.length:
                var kn = 1
                match items[ki]:
                    Value.Int(n): kn = n
                    Value.Uint(n): kn = n as int
                    _: nil
                if ki == 0:
                    kx = kn
                elif ki == 1:
                    ky = kn
                else:
                    kz = kn
                ki = ki + 1
            (kx, ky, kz)
        _: (1, 1, 1)

def Value kernel_dim_value(int x, int y, int z):
    Value.Object(ObjectInner(type_name= "__Dim3", fields= [("x", Value.Int(x)), ("y", Value.Int(y)), ("z", Value.Int(z))]))

# A big array a kernel only reads is kept in 256-element chunks (`__ArrayRef`): every thread reads
# it, and reading an element of a plain array copies the whole array.
def Value chunk_array(Value arr):
    match arr:
        Value.Array(items):
            mut [(string, Value)] chunks = [("n", Value.Int(items.length))]
            var start = 0
            var k = 0
            while start < items.length:
                mut [Value] chunk = []
                var j = start
                while j < items.length and j < start + 256:
                    chunk.push(items[j])
                    j = j + 1
                chunks.push(("c{k}", Value.Array(chunk)))
                start = start + 256
                k = k + 1
            Value.Object(ObjectInner(type_name= "__ArrayRef", fields= chunks))
        _: arr

def Value chunked_array_get(ObjectInner'actor chunked_obj, Value idx):
    var at = 0
    match idx:
        Value.Int(n): at = n
        Value.Uint(n): at = n as int
        _: throw "array index must be an integer"
    let ck = "c{at / 256}"
    if at >= 0:
        if let chunk = chunked_obj.get_field(ck):
            match chunk:
                Value.Array(items):
                    let within = at % 256
                    if within < items.length:
                        return items[within]
                _: nil
    throw "array index {at} out of bounds"

# Does `name` appear as the root of an assignment target (or anything this scan does not understand)?
def bool expr_may_write(mut Interpreter interp, Expr e, string name):
    match e.kind:
        ExprKind.Assign(target, value):
            if target_root_is(target, name):
                return true
            return expr_may_write(interp, value, name)
        ExprKind.Int(_): false
        ExprKind.UInt64(_): false
        ExprKind.Float(_): false
        ExprKind.Str(_): false
        ExprKind.Bool(_): false
        ExprKind.Nil: false
        ExprKind.Var(_): false
        ExprKind.DotIdent(_): false
        ExprKind.BinOp(_, l, r): expr_may_write(interp, l, name) or expr_may_write(interp, r, name)
        ExprKind.UnaryOp(_, x): expr_may_write(interp, x, name)
        ExprKind.Field(x, _): expr_may_write(interp, x, name)
        ExprKind.Index(a, i): expr_may_write(interp, a, name) or expr_may_write(interp, i, name)
        ExprKind.Cast(x, _): expr_may_write(interp, x, name)
        ExprKind.Tuple(elems):
            for el in elems:
                if expr_may_write(interp, el, name):
                    return true
            false
        ExprKind.Call(callee, args):
            for a in args:
                if expr_may_write(interp, a.value, name):
                    return true
            false
        ExprKind.MethodCall(recv, _, args):
            if target_root_is(recv, name):
                return true
            for a in args:
                if expr_may_write(interp, a.value, name):
                    return true
            false
        _: true

def bool target_root_is(Expr t, string name):
    match t.kind:
        ExprKind.Var(n): n == name
        ExprKind.Index(a, _): target_root_is(a, name)
        ExprKind.Field(a, _): target_root_is(a, name)
        _: false

def bool stmts_may_write(mut Interpreter interp, [Stmt] stmts, string name):
    for st in stmts:
        match st:
            Stmt.Expr(e):
                if expr_may_write(interp, e, name):
                    return true
            Stmt.Let(l):
                if let lv = l.value:
                    if expr_may_write(interp, lv, name):
                        return true
            Stmt.If(ifs):
                for br in ifs.branches:
                    if expr_may_write(interp, br.cond, name) or stmts_may_write(interp, br.body, name):
                        return true
                if let eb = ifs.else_body:
                    if stmts_may_write(interp, eb, name):
                        return true
            Stmt.For(f):
                if expr_may_write(interp, f.iterable, name) or stmts_may_write(interp, f.body, name):
                    return true
            _: return true
    false

def bool stmt_is_sync(Stmt st):
    match st:
        Stmt.Comment(c): c == "sync"
        Stmt.Expr(e):
            match e.kind:
                ExprKind.Var(n): n == "sync"
                _: false
        _: false

def Env'actor make_thread_env(Env? shared, Value thread_dim, Value block_dim, Value grid_dim):
    mut e = new_env(shared)
    e.define_mut("__k_thread", thread_dim)
    e.define_mut("__k_block", block_dim)
    e.define_mut("__k_grid", grid_dim)
    e

def Value run_kernel(mut Interpreter interp, Value kself, [Value] args):
    match kself:
        Value.Object(ko): return run_kernel_inner(interp, kself, ko, args)
        _: throw "not a kernel"

def Value run_kernel_inner(mut Interpreter interp, Value kself, ObjectInner'actor kobj, [Value] args):
    guard let decl = interp.get_struct_decl(kobj.type_name) else: throw "kernel not found"
    var FnDecl? entry_opt = nil
    for m in decl.methods:
        if m.name == "__call__":
            entry_opt = m
    guard let entry = entry_opt else: throw "kernel '{kobj.type_name}' has no `def ():` body"
    var bx = 1
    var by = 1
    var bz = 1
    var gx = 1
    var gy = 1
    var gz = 1
    for a in args:
        match a:
            Value.Labeled(lname, lval):
                if lname == "block":
                    let bd = kernel_dims(lval)
                    bx = bd.0
                    by = bd.1
                    bz = bd.2
                elif lname == "grid":
                    let gd = kernel_dims(lval)
                    gx = gd.0
                    gy = gd.1
                    gz = gd.2
            _: nil
    # The body, cut at each top-level `sync`.
    mut [[Stmt]] phases = []
    var mut [Stmt] current = []
    for st in entry.body:
        if stmt_is_sync(st):
            phases.push(current)
            current = []
        else:
            current.push(st)
    phases.push(current)
    let saved_env = interp.current_env
    mut shared = new_env(interp.global_env)
    mut [string] chunked_names = []
    for f in kobj.fields:
        var stored = f.1
        match f.1:
            Value.Array(big_items):
                if big_items.length >= 512 and not stmts_may_write(interp, entry.body, f.0):
                    stored = chunk_array(f.1)
                    chunked_names.push(f.0)
            _: nil
        shared.define_mut(f.0, stored)
    shared.define_mut("self", kself)
    let shared_holder = Value.Closure([], ClosureBody.Block([]), shared)
    let grid_val = kernel_dim_value(gx, gy, gz)
    let prev_kernel = interp.in_kernel_context
    interp.in_kernel_context = true
    var failed = false
    var gzi = 0
    while gzi < gz and not failed:
        var gyi = 0
        while gyi < gy and not failed:
            var gxi = 0
            while gxi < gx and not failed:
                let block_val = kernel_dim_value(gxi, gyi, gzi)
                mut [Value] threads = []
                var tz = 0
                while tz < bz:
                    var ty = 0
                    while ty < by:
                        var tx = 0
                        while tx < bx:
                            match shared_holder:
                                Value.Closure(_, _, shcap):
                                    threads.push(Value.Closure([], ClosureBody.Block([]), make_thread_env(shcap, kernel_dim_value(tx, ty, tz), block_val, grid_val)))
                                _: nil
                            tx = tx + 1
                        ty = ty + 1
                    tz = tz + 1
                for phase in phases:
                    for tval in threads:
                        if not failed:
                            match tval:
                                Value.Closure(_, _, tcap):
                                    if let tenv = tcap:
                                        interp.current_env = tenv
                                _: nil
                            _ = eval_block(interp, phase)
                            if interp.has_pending_throw:
                                failed = true
                gxi = gxi + 1
            gyi = gyi + 1
        gzi = gzi + 1
    interp.in_kernel_context = prev_kernel
    interp.current_env = saved_env
    match kself:
        Value.Object(wb):
            match shared_holder:
                Value.Closure(_, _, wcap):
                    if let wenv = wcap:
                        for f in kobj.fields:
                            if not chunked_names.contains(f.0):
                                if let nv = wenv.get(f.0):
                                    wb.set_field(f.0, nv)
                _: nil
        _: nil
    Value.Void

def bool decl_is_kernel(StructDecl decl):
    attrs_have(decl.attrs, "kernel")


# ─── exec_kernel_block ────────────────────────────────────────────────────────
#
# Executes the body of a `kernel:` block.
# Strategy mirrors the Rust interpreter (eval_gpu.rs):
#   1. Set in_kernel_context = true so callers can detect kernel scope.
#   2. For each statement that is an expression returning a KernelHandle,
#      write the merged result back to the kernel variable in scope.
#   3. All other statements execute normally.
# Parallelism: the Boring interpreter uses synchronous `task` semantics,
# so threads run sequentially here (same as how JoinAll works in eval.br).
# True thread-level parallelism would require rayon, which is only available
# in the Rust host; this structure is the correct foundation for it.

def Signal? exec_kernel_block(mut Interpreter interp, [Stmt] stmts):
    let prev_kernel = interp.in_kernel_context
    interp.in_kernel_context = true
    var Signal? result = nil
    var i = 0
    while i < stmts.length and result == nil:
        let stmt = stmts[i]
        i = i + 1
        match stmt:
            Stmt.Expr(expr):
                let val = eval_expr(interp, expr)
                if interp.has_pending_throw:
                    result = ThrowSignal(interp.take_pending_throw())
                else:
                    nil
            _:
                let sig = exec_stmt(interp, stmt)
                if sig != nil:
                    result = sig
    interp.in_kernel_context = prev_kernel
    result

# Extract the variable name from a bare `k(block=N)` expression so we can
# write back the merged kernel result, mirroring `exec_kernel_block_inner` in
# the Rust interpreter.
def string? kernel_expr_var_name(Expr expr):
    match expr.kind:
        ExprKind.Call(callee, _):
            match callee.kind:
                ExprKind.Var(name): some(name)
                _: nil
        _: nil

# ─── exec_stream_fn ───────────────────────────────────────────────────────────

def [Value] exec_stream_fn(mut Interpreter interp, [Stmt] stmts):
    let prev_in_stream = interp.in_stream_fn
    let prev_yields = interp.stream_yields
    interp.in_stream_fn = true
    interp.stream_yields = []
    let stream_sig = exec_block_fn(interp, stmts)
    interp.in_stream_fn = prev_in_stream
    let result = interp.stream_yields
    interp.stream_yields = prev_yields
    # A `throw` ends the stream with that error (a `throws` stream function).
    match stream_sig:
        ThrowSignal(tv): interp.set_pending_throw(tv)
        _: nil
    result

# `T'...'observed` (the outermost qualifier is `'observed`).
def bool type_is_observed(Type ty):
    match ty:
        Type.Qualified(inner, qual):
            match qual:
                OwnerQual.Observed: true
                _: type_is_observed(inner)
        _: false

# Does an attribute list carry `@name`?
def bool attrs_have([Attr] attrs, string name):
    for a in attrs:
        if a.name == name:
            return true
    false

# ─── call_fn ──────────────────────────────────────────────────────────────────

# Record the final value of each `mut`/`var` parameter (read from the callee's scope `env`)
# in `interp.last_var_params` so the call site can write it back — see that field's doc.
def void capture_var_param_outs(mut Interpreter interp, [Param] params, Env'actor env):
    mut [(int, string, Value)] outs = []
    var i = 0
    while i < params.length:
        let p = params[i]
        if p.mutable:
            let cur = env.get(p.name.clone())
            if let v = cur:
                outs.push((i, p.name.clone(), v))
        i += 1
    interp.last_var_params = outs

def Value call_fn(mut Interpreter interp, FnDecl decl, [Value] args, Env'actor? captured):
    # `@singleton`: the body runs at most once; every later call returns the cached value.
    if attrs_have(decl.attrs, "singleton"):
        let cached = interp.singletons.get(decl.name)
        if let hit = cached:
            return hit
        let fresh = call_fn_body(interp, decl, args, captured)
        mut {string=Value} sing = interp.singletons
        sing.set(decl.name, fresh)
        interp.singletons = sing
        return fresh
    call_fn_body(interp, decl, args, captured)

def Value call_fn_body(mut Interpreter interp, FnDecl decl, [Value] args, Env'actor? captured):
    let base_env = captured else interp.global_env
    mut fn_env = new_env(base_env.clone())
    mut {string=Value} labeled = {}
    mut positional = []
    for val in args:
        match val:
            Labeled(label, v):
                labeled.set(label, v)
            _:
                positional.push(val)
    var pos_idx = 0
    for param in decl.params:
        if param.variadic:
            # Collect all remaining positional args into an array
            mut rest = [Value]{}
            while pos_idx < positional.length:
                rest.push(positional[pos_idx])
                pos_idx = pos_idx + 1
            if param.mutable:
                fn_env.define_mut(param.name, Array(rest))
            else:
                fn_env.define(param.name, Array(rest))
        else:
            var val = Nil
            if labeled.has(param.name):
                val = labeled[param.name]
            else:
                if pos_idx < positional.length:
                    val = positional[pos_idx]
                    pos_idx = pos_idx + 1
                else:
                    if let default_expr = param.default:
                        let dprev = interp.current_env
                        interp.current_env = base_env.clone()
                        val = eval_expr(interp, default_expr)
                        interp.current_env = dprev
            if param.mutable:
                fn_env.define_mut(param.name, val)
            else:
                fn_env.define(param.name, val)
    for param in decl.params:
        if let ty = param.ty:
            let param_name = param.name
            let current = fn_env.get(param_name.clone())
            if let val = current:
                let coerced = if param.variadic:
                    coerce_array_elements(interp, val, ty)
                else:
                    coerce_declared_value(interp, val, ty)
                fn_env.force_set(param_name, coerced.clone())
                mark_byvalue_param(interp, param, coerced)
                mark_alias_binding(interp, param.name, param.ty)
    let prev_env = interp.current_env
    interp.current_env = fn_env
    # Push this call's declared return type so `return .Left` (exec_stmt's Return case)
    # can resolve the enum shorthand via eval_dot_ident_hint instead of eval_dot_ident's
    # ambiguous-scan default — mirrors the Rust interpreter's return_ty_stack
    # (src/interpreter/call.rs / exec.rs).
    push_return_ty(interp, decl.return_ty)
    if decl.is_stream:
        # Stream function: collect all yielded values into an array
        let stream_result = exec_stream_fn(interp, decl.body)
        capture_var_param_outs(interp, decl.params, fn_env)
        pop_return_ty(interp)
        interp.current_env = prev_env
        if interp.has_pending_throw:
            return Value.Nil
        return Value.Array(stream_result)
    let sig = exec_block_fn(interp, decl.body)
    capture_var_param_outs(interp, decl.params, fn_env)
    drop_scope_subscriptions(interp, fn_env, -1)
    pop_return_ty(interp)
    interp.current_env = prev_env
    match sig:
        nil: Nil
        ReturnSignal(v):
            # `fixed16_16 f(float64 x): x` needs an explicit `as`; a literal result adopts the format.
            if let ret_ty = decl.return_ty:
                if not fixed_result_has_literal(decl.body, true):
                    check_fixed_returned(ret_ty, v, decl.name)
                check_fixed_returned_tuple(ret_ty, v, decl.body, decl.name)
                return coerce_declared_value(interp, v, ret_ty)
            v
        ThrowSignal(v):
            interp.set_pending_throw(v)
            Nil
        _: Nil

# Instance methods already have their self/field/parameter scope installed.
def Value exec_method_body(mut Interpreter interp, FnDecl decl):
    push_return_ty(interp, decl.return_ty)
    if decl.is_stream:
        # Stream method: run the body to completion, collecting every `yield` (same eager
        # model as a stream function in call_fn); a `throw` ends the stream with that error.
        let prev_in_stream = interp.in_stream_fn
        let prev_yields = interp.stream_yields
        interp.in_stream_fn = true
        interp.stream_yields = []
        let stream_sig = exec_block_fn(interp, decl.body)
        interp.in_stream_fn = prev_in_stream
        let collected = interp.stream_yields
        interp.stream_yields = prev_yields
        pop_return_ty(interp)
        match stream_sig:
            ThrowSignal(tv):
                interp.set_pending_throw(tv)
                return Value.Nil
            _: return Value.Array(collected)
    let sig = exec_block_fn(interp, decl.body)
    pop_return_ty(interp)
    match sig:
        ReturnSignal(v): v
        ThrowSignal(v):
            interp.set_pending_throw(v)
            Value.Nil
        _: Value.Nil

# ─── call_closure ─────────────────────────────────────────────────────────────

def Value call_closure(mut Interpreter interp, [Param] params, ClosureBody body, [Value] args, Env? captured):
    mut fn_env = new_env(captured)
    var i = 0
    for param in params:
        let val = if i < args.length: args[i] else: Nil
        fn_env.define(param.name, val)
        i = i + 1
    let prev_env = interp.current_env
    interp.current_env = fn_env
    var Signal? sig = nil
    match body:
        ClosureBody.Block(stmts):
            sig = exec_block_fn(interp, stmts)
        ClosureBody.Expr(e):
            sig = Signal.ReturnSignal(eval_expr(interp, e))
    interp.current_env = prev_env
    match sig:
        nil: Nil
        ReturnSignal(v): v
        BreakSignal(v): v
        ContinueSignal: Nil
        ThrowSignal(v):
            interp.set_pending_throw(v)
            Nil
        _: Nil

# ─── call_value ───────────────────────────────────────────────────────────────

# Evaluate a trailing array-block body as a list of values. The main front-end
# desugars this syntax before evaluation; the self-hosted parser currently
# represents the same block as the constructor's final closure argument, so
# collect its expression statements (and control-flow bodies) here.
# The key of a `for` inside an array block: its explicit `with` key, else `item.id()` when the
# element is `Identifiable`; nil for a plain unkeyed loop. Runs in the loop's scope.
def Value? array_block_key(mut Interpreter interp, ForStmt for_stmt, Value item):
    if let key_expr = for_stmt.key:
        return eval_expr(interp, key_expr)
    match item:
        Value.Object(io):
            if let sd = interp.get_struct_decl(io.type_name):
                for proto in sd.protocols:
                    if proto == "Identifiable":
                        return call_method(interp, item, "id", [])
            nil
        _: nil

# ── static site numbering (`Sited`) ────────────────────────────────────────────
# A `[View]` array block with `if`/`for` control flow tags each pushed element with its position
# in the block's source: `Sited(site = n, children = [element])`, numbered in preorder, one number
# per element expression and per keyed `for` (not per iteration), whichever branch runs.

def bool block_has_control_flow([Stmt] stmts):
    for st in stmts:
        match st:
            Stmt.If(_): return true
            Stmt.For(_): return true
            _: nil
    false

# How many site numbers `stmts` consumes (a branch that does not run still takes its share).
def int count_site_items(mut Interpreter interp, [Stmt] stmts):
    var n = 0
    for st in stmts:
        match st:
            Stmt.Expr(_): n = n + 1
            Stmt.If(ifs):
                for br in ifs.branches:
                    n = n + count_site_items(interp, br.body)
                if let eb = ifs.else_body:
                    n = n + count_site_items(interp, eb)
            Stmt.For(fs):
                if let _ = fs.key:
                    n = n + 1
            _: nil
    n

def bool value_is_view(mut Interpreter interp, Value v):
    match v:
        Value.Object(o):
            if let sd = interp.get_struct_decl(o.type_name):
                return decl_is_view(sd)
            false
        _: false

def Value site_wrap(mut Interpreter interp, Value elem):
    if not interp.block_site_on:
        return elem
    if not value_is_view(interp, elem):
        return elem
    guard let sited = interp.get_struct_decl("Sited") else: return elem
    let site_no = interp.block_site
    interp.block_site = site_no + 1
    instantiate_struct(interp, sited, [Value.Labeled("site", Value.Int(site_no)), Value.Labeled("children", Value.Array([elem]))])

# The body of one `for` iteration: its items, grouped under their key when the loop is keyed.
def [Value] collect_for_iteration(mut Interpreter interp, ForStmt for_stmt, Value item, int site_no):
    let child = push_scope(interp)
    if for_stmt.vars.length > 0:
        env_define(interp, for_stmt.vars[0], item, false)
    mut [Value] out = []
    let saved_on = interp.block_site_on
    let saved_site = interp.block_site
    var key_opt = array_block_key(interp, for_stmt, item)
    var keyed = false
    if let _ = key_opt:
        keyed = true
    # An unkeyed loop keeps positional identity: its items are not tagged. A keyed loop numbers its
    # own items afresh.
    interp.block_site_on = saved_on and keyed
    interp.block_site = 0
    let nested = collect_array_block_stmts(interp, for_stmt.body)
    interp.block_site_on = saved_on
    interp.block_site = saved_site
    if let key = key_opt:
        let keyed_decl_opt = interp.get_struct_decl("KeyedGroup")
        if let keyed_decl = keyed_decl_opt:
            let group = instantiate_struct(interp, keyed_decl, [Value.Str(display_value(interp, key)), Value.Array(nested)])
            out.push(site_wrap(interp, group))
        else:
            throw "keyed array block requires a KeyedGroup struct"
    else:
        for value in nested:
            out.push(value)
    pop_scope(interp)
    out

def [Value] collect_array_block_stmts(mut Interpreter interp, [Stmt] stmts):
    mut [Value] out = []
    for stmt in stmts:
        match stmt:
            Stmt.Expr(e):
                out.push(site_wrap(interp, eval_expr(interp, e)))
            Stmt.For(for_stmt):
                let iterable = eval_expr(interp, for_stmt.iterable)
                # One number for a keyed loop, taken once (all iterations share it).
                var loop_keyed = false
                if let _ = for_stmt.key:
                    loop_keyed = true
                let loop_site = interp.block_site
                var iterations = 0
                match iterable:
                    Value.Array(items):
                        for item in items:
                            interp.block_site = loop_site
                            let part = collect_for_iteration(interp, for_stmt, item, loop_site)
                            for value in part:
                                out.push(value)
                            iterations = iterations + 1
                    Value.Range(start, end, inclusive, _):
                        let limit = if inclusive: end + 1 else: end
                        var n = start
                        while n < limit:
                            interp.block_site = loop_site
                            let part = collect_for_iteration(interp, for_stmt, Value.Int(n), loop_site)
                            for value in part:
                                out.push(value)
                            iterations = iterations + 1
                            n += 1
                    _: throw "array block for-loop requires an iterable"
                # A keyed loop that never ran still owns its number.
                if iterations == 0 and loop_keyed:
                    interp.block_site = loop_site + 1
            Stmt.If(if_stmt):
                var matched = false
                for branch in if_stmt.branches:
                    if not matched and val_to_bool(eval_expr(interp, branch.cond)):
                        let nested = collect_array_block_stmts(interp, branch.body)
                        for value in nested:
                            out.push(value)
                        matched = true
                    else:
                        interp.block_site = interp.block_site + count_site_items(interp, branch.body)
                if let else_body = if_stmt.else_body:
                    if not matched:
                        let nested = collect_array_block_stmts(interp, else_body)
                        for value in nested:
                            out.push(value)
                    else:
                        interp.block_site = interp.block_site + count_site_items(interp, else_body)
            _: throw "unsupported statement in trailing array block"
    out

def [Value] collect_array_block(mut Interpreter interp, ClosureBody body, Env? captured):
    let prev_env = interp.current_env
    interp.current_env = new_env(captured)
    let saved_site_on = interp.block_site_on
    let saved_site = interp.block_site
    var mut [Value] values = []
    match body:
        ClosureBody.Block(stmts):
            var tagged = false
            if block_has_control_flow(stmts):
                if let _ = interp.get_struct_decl("Sited"):
                    tagged = true
            interp.block_site_on = tagged
            interp.block_site = 0
            values = collect_array_block_stmts(interp, stmts)
        ClosureBody.Expr(e):
            values = [eval_expr(interp, e)]
    interp.block_site_on = saved_site_on
    interp.block_site = saved_site
    interp.current_env = prev_env
    values

def Value call_value(mut Interpreter interp, Value callee, [Value] args):
    match callee:
        Value.Fn(name, captured):
            let decl = lookup_fn_decl(interp, name)
            call_fn(interp, decl, args, captured)

        Value.Closure(params, body_stmts, captured):
            call_closure(interp, params, body_stmts, args, captured)

        Value.NativeFn(name, func):
            call_native(interp, name, func, args)

        Value.OverloadedFn(name, variants):
            let best = resolve_overload(interp, variants, args)
            call_value(interp, best, args)

        Value.StructDef(name):
            let decl_opt = interp.get_struct_decl(name)
            if let decl = decl_opt:
                var ctor_args = args
                if decl.fields.length > 0 and ctor_args.length > 0:
                    let last_field = decl.fields[decl.fields.length - 1]
                    match last_field.ty:
                        Type.Array(_):
                            let last_idx = ctor_args.length - 1
                            match ctor_args[last_idx]:
                                Value.Closure(_, body, captured):
                                    ctor_args[last_idx] = Value.Labeled(last_field.name, Value.Array(collect_array_block(interp, body, captured)))
                                _: nil
                        _: nil
                instantiate_struct(interp, decl, ctor_args)
            else:
                throw "struct not found: {name}"

        Value.EnumDef(name):
            let variant_name = match args[0] else Value.Nil:
                Value.Str(s): s
                _: throw "enum constructor requires variant name"
            mut fields = []
            var i = 1
            while i < args.length:
                fields.push(args[i])
                i = i + 1
            Value.EnumVariant(name, variant_name, fields)

        Value.EnumVariant(type_name, variant, _):
            Value.EnumVariant(type_name, variant, args)

        Value.Object(obj):
            # A `kernel` instance launched as `k(block = ..., grid = ...)`.
            if let kdecl = interp.get_struct_decl(obj.type_name):
                if decl_is_kernel(kdecl):
                    return run_kernel(interp, callee, args)
            # Callable struct: look for __call__ method
            let obj_type = obj.type_name
            let method_opt = interp.find_best_method(obj_type, "__call__", args)
            if let _ = method_opt:
                call_method(interp, Value.Object(obj), "__call__", args)
            else:
                throw "struct '{obj_type}' is not callable"

        _: throw "value is not callable"

# ─── helpers ──────────────────────────────────────────────────────────────────

def string normalize_type_name(string name):
    if name == "String": "string"
    else if name == "Int": "int"
    else if name == "Uint": "uint"
    else if name == "Uint8": "uint8"
    else if name == "Int8": "int8"
    else if name == "Int16": "int16"
    else if name == "Int32": "int32"
    else if name == "Int64": "int64"
    else if name == "Int128": "int128"
    else if name == "Uint16": "uint16"
    else if name == "Uint32": "uint32"
    else if name == "Uint64": "uint64"
    else if name == "Uint128": "uint128"
    else if name == "Float16": "float16"
    else if name == "Float32": "float32"
    # `Float64`/`float64` are accepted spellings of `Float`/`float` here too —
    # `value_type_name` reports "float" for a Value.Float64 (`float` is
    # `float64`'s pure alias, docs/float-width-types.md §2), so this needs to
    # normalize to the same string, not "float64", for the `==` comparison in
    # `exec_try` below to actually match.
    else if name == "Float": "float"
    else if name == "Float64": "float"
    else if name == "Bool": "bool"
    else if name == "Nil": "nil"
    else: name

def bool expect_bool(Value val):
    match val:
        Bool(b): b
        _: throw "expected bool"

def string value_type_name(Value val):
    match val:
        Nil: "nil"
        Void: "void"
        Uninitialized: "uninitialized"
        Bool(_): "bool"
        Int(_): "int"
        Uint(_): "uint"
        Uint8(_): "uint8"
        Int8(_): "int8"
        Int16(_): "int16"
        Int32(_): "int32"
        Int64(_): "int64"
        Int128(_): "int128"
        Uint16(_): "uint16"
        Uint32(_): "uint32"
        Uint64(_): "uint64"
        Uint128(_): "uint128"
        Float16(_): "float16"
        Fixed(_, fsg, fn_, fm): fixed_type_name(fsg, fn_, fm)
        Float32(_): "float32"
        Float64(_): "float"
        Str(_): "string"
        Array(_): "array"
        LabeledArray(_, _): "array"
        Tuple(_): "tuple"
        Dict(_): "dict"
        Set(_): "set"
        Object(inner): inner.type_name.clone()
        EnumVariant(t, _, _): t
        Fn(n, _): "fn({n})"
        Closure(_, _, _): "closure"
        NativeFn(n, _): "native({n})"
        OverloadedFn(n, _): "fn({n})"
        Range(_, _, _, _): "range"
        Labeled(_, _): "labeled"
        StructDef(n): "struct:{n}"
        EnumDef(n): "enum:{n}"

def bool value_equals(Value a, Value b):
    match a:
        Uninitialized:
            match b:
                Uninitialized: true
                _: false
        Nil:
            match b:
                Nil: true
                _: false
        Bool(x):
            match b:
                Bool(y): x == y
                _: false
        Int(x):
            match b:
                Int(y): x == y
                _: false
        # float32/float64 compare freely against each other here too — same
        # permissive precedent as `values_equal` in stdlib.br
        # (docs/float-width-types.md §3).
        Float64(x):
            match b:
                Float64(y): x == y
                Float32(y): x == (y as float64)
                Float16(y): x == (y as float64)
                _: false
        Float16(x):
            match b:
                Float16(y): x == y
                Float32(y): (x as float64) == (y as float64)
                Float64(y): (x as float64) == y
                _: false
        Float32(x):
            match b:
                Float32(y): x == y
                Float64(y): (x as float64) == y
                Float16(y): (x as float64) == (y as float64)
                _: false
        Str(x):
            match b:
                Str(y): x == y
                _: false
        Set(xa):
            match b:
                Set(ya):
                    if xa.length != ya.length:
                        false
                    else:
                        var all_found = true
                        for elem in xa:
                            var found = false
                            for other in ya:
                                if value_equals(elem, other):
                                    found = true
                            if not found:
                                all_found = false
                        all_found
                _: false
        _: false


# True when some expression the body can yield (a `return <expr>` at any depth, or the tail
# expression — descending into a trailing `if`/`match`) is an untyped numeric literal.
# Mirrors `collect_result_exprs` in the Rust interpreter's call.rs.
# Every expression a function body can yield as its result: `return` values anywhere,
# the tail expression, and trailing if/match arms (loop/try bodies only contribute returns).
[Expr] fixed_result_exprs([Stmt] body, bool tail):
    mut [Expr] out = []
    var i = 0
    while i < body.length:
        let is_tail = tail and i + 1 == body.length
        match body[i]:
            Stmt.Return(rs):
                if let rv = rs.value:
                    out.push(rv)
            Stmt.Expr(e):
                if is_tail:
                    out.push(e)
            Stmt.If(ifs):
                for br in ifs.branches:
                    out.extend(fixed_result_exprs(br.body, is_tail))
                if let eb = ifs.else_body:
                    out.extend(fixed_result_exprs(eb, is_tail))
            Stmt.Match(ms):
                for arm in ms.arms:
                    match arm.body:
                        MatchBody.Expr(me):
                            if is_tail:
                                out.push(me)
                        MatchBody.Block(bs):
                            out.extend(fixed_result_exprs(bs, is_tail))
            Stmt.While(ws): out.extend(fixed_result_exprs(ws.body, false))
            Stmt.For(fs): out.extend(fixed_result_exprs(fs.body, false))
            Stmt.Loop(ls): out.extend(fixed_result_exprs(ls.body, false))
            Stmt.Try(ts): out.extend(fixed_result_exprs(ts.body, false))
            _: nil
        i += 1
    out

bool fixed_result_has_literal([Stmt] body, bool tail):
    for e in fixed_result_exprs(body, tail):
        if is_untyped_numeric_literal(e):
            return true
    false

# `(fixed16_16, int) f(float64 x): (x, 1)`: a tuple-literal result passes when one of the
# tuple-literal results gives every fixed slot a literal (same leniency as the scalar rule).
def check_fixed_returned_tuple(Type ty, Value v, [Stmt] body, string fname):
    var string? first_err = nil
    var any_ok = false
    for e in fixed_result_exprs(body, true):
        match e.kind:
            ExprKind.Tuple(_):
                let msg = fixed_tuple_slots_error(ty, e, v, "return", "'{fname}'")
                if let m = msg:
                    if first_err == nil:
                        first_err = m
                else:
                    any_ok = true
            _: nil
    if not any_ok:
        if let m = first_err:
            throw m

def check_fixed_returned(Type ty, Value v, string fname):
    match ty:
        Type.Qualified(inner, _): check_fixed_returned(inner, v, fname)
        Type.Named(tname):
            if let f = fixed_fmt_of_name(tname):
                match v:
                    Value.Int(_) | Value.Float64(_):
                        throw "function '{fname}' declared to return {f.name()}, but got {value_type_name(v)}; convert explicitly with `as {f.name()}`"
                    _: nil
        _: nil
